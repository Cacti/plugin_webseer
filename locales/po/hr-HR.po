#: includes/arrays.php
msgid "General Settings"
msgstr "Opće postavke"

#: includes/arrays.php
msgid "Display Name of this server"
msgstr "Prikazni naziv ovog poslužitelja"

#: includes/arrays.php webseer_servers.php
msgid "Enable Server"
msgid_plural "Enable Servers"
msgstr[0] "Omogući poslužitelj"
msgstr[1] "Omogući poslužitelje"
msgstr[2] "Omogući poslužitelje"

#: includes/arrays.php
msgid "Uncheck this box to disabled this server from checking urls."
msgstr "Poništite ovaj okvir kako biste onemogućili ovom poslužitelju provjeru URL adresa."

#: includes/arrays.php
msgid "Is this server the local server?"
msgstr "Je li ovaj poslužitelj lokalni poslužitelj?"

#: includes/arrays.php
msgid "Check this box if the current server you are connected to is this entry."
msgstr "Označite ovaj okvir ako je trenutačni poslužitelj na koji ste povezani upravo ovaj unos."

#: includes/arrays.php
msgid "Master Server"
msgstr "Glavni poslužitelj"

#: includes/arrays.php
msgid "Sets this server to the Master server.  The Master server handles all Email operations"
msgstr "Postavlja ovaj poslužitelj kao glavni poslužitelj. Glavni poslužitelj obrađuje sve radnje e-pošte"

#: includes/arrays.php webseer_servers.php
msgid "IP Address"
msgstr "IP adresa"

#: includes/arrays.php
msgid "IP Address to connect to this server"
msgstr "IP adresa za povezivanje s ovim poslužiteljem"

#: includes/arrays.php webseer.php webseer_servers.php
msgid "URL"
msgstr "URL"

#: includes/arrays.php
msgid "This is the URL to connect to remote.php on this server."
msgstr "Ovo je URL za povezivanje s datotekom remote.php na ovom poslužitelju."

#: includes/arrays.php webseer_servers.php
msgid "Location"
msgstr "Lokacija"

#: includes/arrays.php
msgid "Location of this server"
msgstr "Lokacija ovog poslužitelja"

#: includes/arrays.php
msgid "Service Check Name"
msgstr "Naziv provjere usluge"

#: includes/arrays.php
msgid "The name that is displayed for this Service Check, and is included in any Alert notifications."
msgstr "Naziv koji se prikazuje za ovu provjeru usluge i uključuje se u sve obavijesti o upozorenjima."

#: includes/arrays.php webseer.php
msgid "Enable Service Check"
msgstr "Omogući provjeru servisa"

#: includes/arrays.php
msgid "Uncheck this box to disabled this url from being checked."
msgstr "Poništite ovaj okvir kako biste onemogućili provjeru ove URL adrese."

#: includes/arrays.php
msgid "The URL to Monitor"
msgstr "URL za nadzor"

#: includes/arrays.php
msgid "Enter an IP address to connect to.  Leaving blank will use DNS Resolution instead."
msgstr "Unesite IP adresu za povezivanje. Ako ostavite prazno, umjesto toga koristit će se DNS razrješavanje."

#: includes/arrays.php
msgid "Proxy Server"
msgstr "Proxy poslužitelj"

#: includes/arrays.php
msgid "If this connection text requires a proxy, select it here.  Otherwise choose 'None'."
msgstr "Ako ovaj test veze zahtijeva proxy, odaberite ga ovdje.  Inače odaberite 'Ništa'."

#: includes/arrays.php webseer.php
msgid "None"
msgstr "Nijedan"

#: includes/arrays.php webseer.php
msgid "Compression"
msgstr "Sažimanje"

#: includes/arrays.php
msgid "What compression does the server require?  Most servers should not need this, but some will not redirect properly without it."
msgstr "Koje sažimanje zahtijeva poslužitelj? Većini poslužitelja to ne bi trebalo biti potrebno, ali neki se neće ispravno preusmjeriti bez toga."

#: includes/arrays.php
msgid "Available Checks"
msgstr "Dostupne provjere"

#: includes/arrays.php
msgid "Requires Authentication"
msgstr "Zahtijeva autentifikaciju"

#: includes/arrays.php
msgid "Check this box if the site will normally return a 401 Error as it requires a username and password."
msgstr "Označite ovaj okvir ako web mjesto obično vraća pogrešku 401 jer zahtijeva korisničko ime i lozinku."

#: includes/arrays.php
msgid "Check Certificate"
msgstr "Provjeri certifikat"

#: includes/arrays.php
msgid "If using SSL, check this box if you want to validate the certificate. Default on, turn off if you the site uses a self-signed certificate."
msgstr "Ako koristite SSL, označite ovaj okvir ako želite provjeriti valjanost certifikata. Zadano uključeno, isključite ako web mjesto koristi samopotpisani certifikat."

#: includes/arrays.php
msgid "Notification Timing"
msgstr "Vrijeme slanja obavijesti"

#: includes/arrays.php
msgid "Trigger"
msgstr "Okidač"

#: includes/arrays.php
msgid "How many minutes the URL must be down before it will send an alert.  After an alert is sent, in order for a 'Site Recovering' Email to be send, it must also be up this number of minutes."
msgstr "Koliko minuta URL mora biti nedostupan prije nego što se pošalje uzbuna. Nakon što se uzbuna pošalje, da bi se poslala poruka e-pošte 'Oporavak web-mjesta', također mora biti dostupan ovaj broj minuta."

#: includes/arrays.php
msgid "Time Out"
msgstr "Istek vremena"

#: includes/arrays.php
msgid "How many seconds to allow the page to timeout before reporting it as down."
msgstr "Koliko sekundi dopustiti za istek vremena stranice prije nego što se prijavi kao nedostupna."

#: includes/arrays.php
msgid "Verification Strings"
msgstr "Znakovni nizovi za provjeru"

#: includes/arrays.php
msgid "Response Search String"
msgstr "Znakovni niz za pretraživanje u odgovoru"

#: includes/arrays.php
msgid "This is the string to search for in the URL response for a live and working Web Service."
msgstr "Ovo je znakovni niz koji se traži u odgovoru URL adrese za aktivan i ispravan web-servis."

#: includes/arrays.php
msgid "Response Search String - Maintenance Page"
msgstr "Znakovni niz za pretraživanje odgovora - stranica održavanja"

#: includes/arrays.php
msgid "This is the string to search for on the Maintenance Page.  The Service Check will check for this string if the above string is not found.  If found, it means that the Web Service is under maintenance."
msgstr "Ovo je znakovni niz koji se traži na stranici održavanja. Provjera servisa tražit će ovaj znakovni niz ako gornji niz nije pronađen. Ako se pronađe, to znači da je web-servis u održavanju."

#: includes/arrays.php
msgid "Response Search String - Failed"
msgstr "Znakovni niz za pretraživanje u odgovoru - Neuspješno"

#: includes/arrays.php
msgid "This is the string to search for a known failure in the Web Service response.  The Service Check will only alert if this string is found, ignoring any timeout issues and the search strings above."
msgstr "Ovo je niz znakova za pretraživanje poznatog kvara u odgovoru web-usluge. Provjera usluge će poslati upozorenje samo ako se ovaj niz pronađe, zanemarujući probleme s istekom vremena i gornje nizove za pretraživanje."

#: includes/arrays.php
msgid "Notification Settings"
msgstr "Postavke obavijesti"

#: includes/arrays.php
msgid "Notify Format"
msgstr "Format obavijesti"

#: includes/arrays.php
msgid "This is the format to use when sending the notification email"
msgstr "Ovo je format koji se koristi prilikom slanja e-pošte s obavijesti"

#: includes/arrays.php
msgid "Notification List"
msgstr "Popis obavijesti"

#: includes/arrays.php
msgid "Use this Notification List for those to be notified when this website goes down."
msgstr "Koristite ovaj popis obavijesti za one koje treba obavijestiti kada ova web-stranica prestane s radom."

#: includes/arrays.php
msgid "Notify Accounts"
msgstr "Računi za obavijesti"

#: includes/arrays.php
msgid "This is a listing of accounts that will be notified when this website goes down."
msgstr "Ovo je popis računa koji će biti obaviješteni kada ova web-stranica prestane s radom."

#: includes/arrays.php
msgid "Extra Alert Emails"
msgstr "Dodatne adrese e-pošte za upozorenja"

#: includes/arrays.php
msgid "You may specify here extra Emails to receive alerts for this URL (comma separated)"
msgstr "Ovdje možete navesti dodatne adrese e-pošte za primanje upozorenja za ovaj URL (odvojene zarezom)"

