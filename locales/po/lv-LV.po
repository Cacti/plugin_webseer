#: includes/arrays.php:240
msgid "Uncheck this box to disabled this server from checking urls."
msgstr "Noņemiet ķeksi, lai šis serveris neveiktu tīmekļa vietņu adrešu (URLs) pārbaudi."

#: includes/arrays.php:246
msgid "Is this server the local server?"
msgstr "Vai šis serveris ir lokālais serveris?"

#: includes/arrays.php:247
msgid "Check this box if the current server you are connected to is this entry."
msgstr "Atķeksējiet, ja pašreizējais serveris, ar kuru esat izveidojis savienojumu, ir šis."

#: includes/arrays.php:253
msgid "Master Server"
msgstr "Galvenais serveris"

#: includes/arrays.php:254
msgid "Sets this server to the Master server.  The Master server handles all Email operations"
msgstr "Iestata šo serveri par galveno serveri.  Galvenais serveris veic visas e-pasta darbības"

