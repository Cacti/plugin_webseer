#: includes/arrays.php webseer_servers.php
#, fuzzy
msgid "Enable Server"
msgid_plural "Enable Servers"
msgstr[0] "Server inschakelen"
msgstr[1] "Server inschakelen"

#: includes/arrays.php
msgid "Uncheck this box to disabled this server from checking urls."
msgstr "Schakel dit selectievakje uit om te voorkomen dat deze server URL's controleert."

#: includes/arrays.php
msgid "Is this server the local server?"
msgstr "Is deze server de lokale server?"

#: includes/arrays.php
msgid "Check this box if the current server you are connected to is this entry."
msgstr "Vink dit vakje aan als de huidige server waarmee u verbonden bent dit item is."

#: includes/arrays.php
msgid "Master Server"
msgstr "Hoofdserver"

#: includes/arrays.php
msgid "Sets this server to the Master server.  The Master server handles all Email operations"
msgstr "Stelt deze server in als de masterserver. De masterserver verwerkt alle e-mailbewerkingen"

#: includes/arrays.php webseer_servers.php
msgid "IP Address"
msgstr "IP-adres"

#: includes/arrays.php
msgid "IP Address to connect to this server"
msgstr "IP-adres om verbinding te maken met deze server"

#: includes/arrays.php webseer.php webseer_servers.php
msgid "URL"
msgstr "URL"

#: includes/arrays.php
msgid "This is the URL to connect to remote.php on this server."
msgstr "Dit is de URL om verbinding te maken met remote.php op deze server."

#: includes/arrays.php webseer_servers.php
msgid "Location"
msgstr "Locatie"

#: includes/arrays.php
msgid "Location of this server"
msgstr "Locatie van deze server"

#: includes/arrays.php
msgid "Service Check Name"
msgstr "Naam servicecontrole"

#: includes/arrays.php
msgid "The name that is displayed for this Service Check, and is included in any Alert notifications."
msgstr "De naam die wordt weergegeven voor deze servicecontrole en die wordt opgenomen in alle waarschuwingsmeldingen."

#: includes/arrays.php webseer.php
msgid "Enable Service Check"
msgstr "Servicecontrole inschakelen"

#: includes/arrays.php
msgid "Uncheck this box to disabled this url from being checked."
msgstr "Schakel dit selectievakje uit om te voorkomen dat deze URL wordt gecontroleerd."

#: includes/arrays.php
msgid "The URL to Monitor"
msgstr "De te monitoren URL"

#: includes/arrays.php
msgid "Enter an IP address to connect to.  Leaving blank will use DNS Resolution instead."
msgstr "Voer een IP-adres in om verbinding mee te maken. Als u dit leeg laat, wordt in plaats daarvan DNS-omzetting gebruikt."

#: includes/arrays.php
msgid "Proxy Server"
msgstr "Proxy server"

#: includes/arrays.php
msgid "If this connection text requires a proxy, select it here.  Otherwise choose 'None'."
msgstr "Als deze verbindingstekst een proxy vereist, selecteert u deze hier. Kies anders 'Geen'."

#: includes/arrays.php webseer.php
msgid "None"
msgstr "Geen"

#: includes/arrays.php webseer.php
msgid "Compression"
msgstr "Compressie"

#: includes/arrays.php
msgid "What compression does the server require?  Most servers should not need this, but some will not redirect properly without it."
msgstr "Welke compressie vereist de server? De meeste servers hebben dit niet nodig, maar sommige worden zonder dit niet correct omgeleid."

#: includes/arrays.php
msgid "Available Checks"
msgstr "Beschikbare controles"

#: includes/arrays.php
msgid "Requires Authentication"
msgstr "Vereist authenticatie"

#: includes/arrays.php
msgid "Check this box if the site will normally return a 401 Error as it requires a username and password."
msgstr "Vink dit vakje aan als de site normaal gesproken een 401-fout retourneert omdat een gebruikersnaam en wachtwoord vereist zijn."

#: includes/arrays.php
msgid "Check Certificate"
msgstr "Certificaat controleren"

#: includes/arrays.php
msgid "If using SSL, check this box if you want to validate the certificate. Default on, turn off if you the site uses a self-signed certificate."
msgstr "Als u SSL gebruikt, vink dit vakje aan als u het certificaat wilt valideren. Standaard ingeschakeld; schakel dit uit als de site een zelfondertekend certificaat gebruikt."

#: includes/arrays.php
msgid "Notification Timing"
msgstr "Tijdstip van melding"

#: includes/arrays.php
msgid "Trigger"
msgstr "Trigger"

#: includes/arrays.php
msgid "How many minutes the URL must be down before it will send an alert.  After an alert is sent, in order for a 'Site Recovering' Email to be send, it must also be up this number of minutes."
msgstr "Hoeveel minuten de URL onbereikbaar moet zijn voordat een melding wordt verzonden. Nadat een melding is verzonden, moet de URL ook dit aantal minuten bereikbaar zijn voordat een 'Site herstellend'-e-mail wordt verzonden."

#: includes/arrays.php
msgid "Time Out"
msgstr "Time-out"

#: includes/arrays.php
msgid "How many seconds to allow the page to timeout before reporting it as down."
msgstr "Aantal seconden voor een time-out van de pagina voordat deze als inactief wordt gemeld."

#: includes/arrays.php
msgid "Verification Strings"
msgstr "Verificatiestrings"

#: includes/arrays.php
msgid "Response Search String"
msgstr "Zoektekst in reactie"

#: includes/arrays.php
msgid "This is the string to search for in the URL response for a live and working Web Service."
msgstr "Dit is de tekenreeks waarnaar in de URL-respons wordt gezocht voor een actieve en werkende webservice."

#: includes/arrays.php
msgid "Response Search String - Maintenance Page"
msgstr "Zoektekst in reactie - Onderhoudspagina"

#: includes/arrays.php
msgid "This is the string to search for on the Maintenance Page.  The Service Check will check for this string if the above string is not found.  If found, it means that the Web Service is under maintenance."
msgstr "Dit is de tekenreeks waarnaar wordt gezocht op de onderhoudspagina. De servicecontrole zoekt naar deze tekenreeks als de bovenstaande tekenreeks niet wordt gevonden. Als deze wordt gevonden, betekent dit dat de webservice in onderhoud is."

#: includes/arrays.php
msgid "Response Search String - Failed"
msgstr "Zoektekst in reactie - Mislukt"

#: includes/arrays.php
msgid "This is the string to search for a known failure in the Web Service response.  The Service Check will only alert if this string is found, ignoring any timeout issues and the search strings above."
msgstr "Dit is de tekenreeks om te zoeken naar een bekende fout in de respons van de webservice. De servicecontrole geeft alleen een melding als deze tekenreeks wordt gevonden, waarbij eventuele time-outproblemen en de bovenstaande zoekreeksen worden genegeerd."

#: includes/arrays.php
msgid "Notification Settings"
msgstr "Notificatie instellingen"

#: includes/arrays.php
msgid "Notify Format"
msgstr "Meldingsformaat"

#: includes/arrays.php
msgid "This is the format to use when sending the notification email"
msgstr "Dit is de indeling die moet worden gebruikt bij het verzenden van de meldings-e-mail"

#: includes/arrays.php
msgid "Notification List"
msgstr "Meldingslijst"

#: includes/arrays.php
msgid "Use this Notification List for those to be notified when this website goes down."
msgstr "Gebruik deze meldingslijst voor degenen die op de hoogte moeten worden gebracht wanneer deze website uitvalt."

#: includes/arrays.php
msgid "Notify Accounts"
msgstr "Te waarschuwen accounts"

#: includes/arrays.php
msgid "This is a listing of accounts that will be notified when this website goes down."
msgstr "Dit is een lijst met accounts die op de hoogte worden gesteld wanneer deze website uitvalt."

#: includes/arrays.php
msgid "Extra Alert Emails"
msgstr "Extra waarschuwings-e-mails"

#: includes/arrays.php
msgid "You may specify here extra Emails to receive alerts for this URL (comma separated)"
msgstr "U kunt hier extra e-mailadressen opgeven die waarschuwingen voor deze URL moeten ontvangen (kommagescheiden)"

