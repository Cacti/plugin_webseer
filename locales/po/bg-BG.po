msgstr[1] "Активиране на сървъра"

#: includes/arrays.php
msgid "Uncheck this box to disabled this server from checking urls."
msgstr "Премахнете отметката от това квадратче, за да деактивирате проверката на URL адреси от този сървър."

#: includes/arrays.php
msgid "Is this server the local server?"
msgstr "Този сървър ли е локалният сървър?"

#: includes/arrays.php
msgid "Check this box if the current server you are connected to is this entry."
msgstr "Отметнете това поле, ако текущият сървър, към който сте свързани, е този запис."

#: includes/arrays.php
msgid "Master Server"
msgstr "Главен сървър"

#: includes/arrays.php
msgid "Sets this server to the Master server.  The Master server handles all Email operations"
msgstr "Задава този сървър като главен сървър. Главният сървър обработва всички операции с имейл"

#: includes/arrays.php webseer_servers.php
msgid "IP Address"
msgstr "IP Адрес"

#: includes/arrays.php
msgid "IP Address to connect to this server"
msgstr "IP адрес за свързване към този сървър"

#: includes/arrays.php webseer.php webseer_servers.php
msgid "URL"
msgstr "URL"

#: includes/arrays.php
msgid "This is the URL to connect to remote.php on this server."
msgstr "Това е URL адресът за свързване към remote.php на този сървър."

#: includes/arrays.php webseer_servers.php
msgid "Location"
msgstr "Местоположение"

#: includes/arrays.php
msgid "Location of this server"
msgstr "Местоположение на този сървър"

#: includes/arrays.php
msgid "Service Check Name"
msgstr "Име на проверка на услуга"

#: includes/arrays.php
msgid "The name that is displayed for this Service Check, and is included in any Alert notifications."
msgstr "Името, което се показва за тази проверка на услуга и се включва във всички известия за предупреждения."

#: includes/arrays.php webseer.php
msgid "Enable Service Check"
msgstr "Активиране на проверката на услуга"

#: includes/arrays.php
msgid "Uncheck this box to disabled this url from being checked."
msgstr "Премахнете отметката от това квадратче, за да деактивирате проверката на този URL адрес."

#: includes/arrays.php
msgid "The URL to Monitor"
msgstr "URL адрес за наблюдение"

#: includes/arrays.php
msgid "Enter an IP address to connect to.  Leaving blank will use DNS Resolution instead."
msgstr "Въведете IP адрес, към който да се осъществи свързване. Ако оставите празно, ще се използва DNS преобразуване."

#: includes/arrays.php
msgid "Proxy Server"
msgstr "Прокси сървър"

#: includes/arrays.php
msgid "If this connection text requires a proxy, select it here.  Otherwise choose 'None'."
msgstr "Ако този текст за връзка изисква прокси, изберете го тук.  В противен случай изберете „Няма“."

#: includes/arrays.php webseer.php
msgid "None"
msgstr "Няма"

#: includes/arrays.php webseer.php
msgid "Compression"
msgstr "Компресия"

#: includes/arrays.php
msgid "What compression does the server require?  Most servers should not need this, but some will not redirect properly without it."
msgstr "Каква компресия изисква сървърът? Повечето сървъри не би трябвало да се нуждаят от това, но някои няма да пренасочват правилно без нея."

#: includes/arrays.php
msgid "Available Checks"
msgstr "Налични проверки"

#: includes/arrays.php
msgid "Requires Authentication"
msgstr "Изисква удостоверяване"

#: includes/arrays.php
msgid "Check this box if the site will normally return a 401 Error as it requires a username and password."
msgstr "Отметнете това поле, ако сайтът обикновено връща грешка 401, тъй като изисква потребителско име и парола."

#: includes/arrays.php
msgid "Check Certificate"
msgstr "Проверка на сертификат"

#: includes/arrays.php
msgid "If using SSL, check this box if you want to validate the certificate. Default on, turn off if you the site uses a self-signed certificate."
msgstr "Ако използвате SSL, поставете отметка в това поле, ако желаете да се валидира сертификатът. По подразбиране е включено; изключете, ако сайтът използва самоподписан сертификат."

#: includes/arrays.php
msgid "Notification Timing"
msgstr "График на известията"

#: includes/arrays.php
msgid "Trigger"
msgstr "Тригер"

#: includes/arrays.php
msgid "How many minutes the URL must be down before it will send an alert.  After an alert is sent, in order for a 'Site Recovering' Email to be send, it must also be up this number of minutes."
msgstr "Колко минути URL адресът трябва да е неактивен, преди да се изпрати сигнал.  След изпращане на сигнал, за да бъде изпратен имейл за „Възстановяване на сайт“, той трябва също да бъде активен толкова минути."

#: includes/arrays.php
msgid "Time Out"
msgstr "Време на изчакване"

#: includes/arrays.php
msgid "How many seconds to allow the page to timeout before reporting it as down."
msgstr "Колко секунди да се изчака изтичане на времето за страницата, преди да бъде отчетена като неактивна."

#: includes/arrays.php
msgid "Verification Strings"
msgstr "Низове за проверка"

#: includes/arrays.php
msgid "Response Search String"
msgstr "Низ за търсене в отговора"

#: includes/arrays.php
msgid "This is the string to search for in the URL response for a live and working Web Service."
msgstr "Това е низът, който се търси в отговора от URL адреса за активна и работеща уеб услуга."

#: includes/arrays.php
msgid "Response Search String - Maintenance Page"
msgstr "Низ за търсене в отговора - Страница за поддръжка"

#: includes/arrays.php
msgid "This is the string to search for on the Maintenance Page.  The Service Check will check for this string if the above string is not found.  If found, it means that the Web Service is under maintenance."
msgstr "Това е низът, който се търси на страницата за поддръжка. Проверката на услугата ще проверява за този низ, ако горният низ не бъде намерен. Ако бъде намерен, това означава, че уеб услугата е в режим на поддръжка."

#: includes/arrays.php
msgid "Response Search String - Failed"
msgstr "Низ за търсене в отговора - Неуспешно"

#: includes/arrays.php
msgid "This is the string to search for a known failure in the Web Service response.  The Service Check will only alert if this string is found, ignoring any timeout issues and the search strings above."
msgstr "Това е низът, който се търси за известна грешка в отговора на уеб услугата. Проверката на услугата ще известява само ако този низ бъде намерен, като пренебрегва проблемите с изтичане на времето и горните низове за търсене."

#: includes/arrays.php
msgid "Notification Settings"
msgstr "Настройки за известията"

#: includes/arrays.php
msgid "Notify Format"
msgstr "Формат на известяване"

#: includes/arrays.php
msgid "This is the format to use when sending the notification email"
msgstr "Това е форматът, който да се използва при изпращане на имейла за известие"

#: includes/arrays.php
msgid "Notification List"
msgstr "Списък за известия"

#: includes/arrays.php
msgid "Use this Notification List for those to be notified when this website goes down."
msgstr "Използвайте този списък за известяване за получателите, които да бъдат уведомени, когато този уебсайт стане неактивен."

#: includes/arrays.php
msgid "Notify Accounts"
msgstr "Профили за известяване"

#: includes/arrays.php
msgid "This is a listing of accounts that will be notified when this website goes down."
msgstr "Това е списък с акаунти, които ще бъдат уведомени, когато този уебсайт стане неактивен."

#: includes/arrays.php
msgid "Extra Alert Emails"
msgstr "Допълнителни имейли за предупреждения"

#: includes/arrays.php
msgid "You may specify here extra Emails to receive alerts for this URL (comma separated)"
msgstr "Тук можете да посочите допълнителни имейли за получаване на известия за този URL адрес (разделени със запетая)"

