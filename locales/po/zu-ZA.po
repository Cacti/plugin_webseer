#: includes/arrays.php webseer_servers.php
msgid "Enable Server"
msgid_plural "Enable Servers"
msgstr[0] "Nika amandla Iseva"
msgstr[1] "Nika amandla Amaseva"

#: includes/arrays.php
msgid "Uncheck this box to disabled this server from checking urls."
msgstr "Susa ukumaka leli bhokisi ukuze ukhubaze le seva ekuhloleni ama-URL."

#: includes/arrays.php
msgid "Is this server the local server?"
msgstr "Ingabe le seva iyiseva yendawo?"

#: includes/arrays.php
msgid "Check this box if the current server you are connected to is this entry."
msgstr "Maka leli bhokisi uma iseva yamanje oxhumeke kuyo iyilokhu okufakiwe."

#: includes/arrays.php
msgid "Master Server"
msgstr "Iseva Eyinhloko"

#: includes/arrays.php
msgid "Sets this server to the Master server.  The Master server handles all Email operations"
msgstr "Isetha le seva njengeseva Eyinhloko. Iseva Eyinhloko iphatha yonke imisebenzi Ye-imeyili"

#: includes/arrays.php webseer_servers.php
msgid "IP Address"
msgstr "Ikheli le-IP"

#: includes/arrays.php
msgid "IP Address to connect to this server"
msgstr "Ikheli le-IP lokuxhumeka kule seva"

#: includes/arrays.php webseer.php webseer_servers.php
msgid "URL"
msgstr "URL"

#: includes/arrays.php
msgid "This is the URL to connect to remote.php on this server."
msgstr "Lena i-URL yokuxhuma ku-remote.php kule seva."

#: includes/arrays.php webseer_servers.php
msgid "Location"
msgstr "Indawo"

#: includes/arrays.php
msgid "Location of this server"
msgstr "Indawo yale seva"

#: includes/arrays.php
msgid "Service Check Name"
msgstr "Igama Lokuhlola Isevisi"

#: includes/arrays.php
msgid "The name that is displayed for this Service Check, and is included in any Alert notifications."
msgstr "Igama eliboniswayo lalokhu Kuhlolwa Kwesevisi, futhi elifakwe kunoma yiziphi izaziso Ze-Alamu."

#: includes/arrays.php webseer.php
msgid "Enable Service Check"
msgstr "Nika amandla Ukuhlolwa Kwesevisi"

#: includes/arrays.php
msgid "Uncheck this box to disabled this url from being checked."
msgstr "Susa ukumaka leli bhokisi ukuze ukhubaze le URL ekuhlolweni."

#: includes/arrays.php
msgid "The URL to Monitor"
msgstr "I-URL okufanele iqashwe"

#: includes/arrays.php
msgid "Enter an IP address to connect to.  Leaving blank will use DNS Resolution instead."
msgstr "Faka ikheli le-IP ozoxhuma kulo. Ukushiya kungenalutho kuzosebenzisa Ukuxazululwa kwe-DNS esikhundleni salokho."

#: includes/arrays.php
msgid "Proxy Server"
msgstr "Iseva ye-Proxy"

#: includes/arrays.php
msgid "If this connection text requires a proxy, select it here.  Otherwise choose 'None'."
msgstr "Uma lo mbhalo wokuxhumana udinga i-proxy, yikhethe lapha. Ngaphandle kwalokho khetha 'Lutho'."

#: includes/arrays.php webseer.php
msgid "None"
msgstr "Akukho"

#: includes/arrays.php webseer.php
msgid "Compression"
msgstr "Ukucindezela"

#: includes/arrays.php
msgid "What compression does the server require?  Most servers should not need this, but some will not redirect properly without it."
msgstr "Iyiphi indlela yokucindezela edingwa yiseva?  Amaseva amaningi akufanele adinge lokhu, kodwa amanye ngeke aqondise kabusha kahle ngaphandle kwakho."

#: includes/arrays.php
msgid "Available Checks"
msgstr "Ukuhlola Okutholakalayo"

#: includes/arrays.php
msgid "Requires Authentication"
msgstr "Kudinga Ukuqinisekiswa"

#: includes/arrays.php
msgid "Check this box if the site will normally return a 401 Error as it requires a username and password."
msgstr "Maka leli bhokisi uma isayithi ngokuvamile libuyisa Iphutha le-401 njengoba lidinga igama lomsebenzisi nephasiwedi."

#: includes/arrays.php
msgid "Check Certificate"
msgstr "Hlola Isitifiketi"

#: includes/arrays.php
msgid "If using SSL, check this box if you want to validate the certificate. Default on, turn off if you the site uses a self-signed certificate."
msgstr "Uma usebenzisa i-SSL, khetha leli bhokisi uma ufuna ukuqinisekisa isitifiketi. Kuvuliwe ngokuzenzakalelayo, kuvale uma isayithi lisebenzisa isitifiketi esizisayinelwe."

#: includes/arrays.php
msgid "Notification Timing"
msgstr "Isikhathi sezaziso"

#: includes/arrays.php
msgid "Trigger"
msgstr "Isiqalisi"

#: includes/arrays.php
msgid "How many minutes the URL must be down before it will send an alert.  After an alert is sent, in order for a 'Site Recovering' Email to be send, it must also be up this number of minutes."
msgstr "Mingaki imizuzu i-URL okufanele ibe phansi ngaphambi kokuba ithumele isexwayiso.  Ngemva kokuthunyelwa kwesexwayiso, ukuze kuthunyelwe I-imeyili ethi 'Isayithi Liyalulama', kufanele futhi ibe phezulu lelo nani lemizuzu."

#: includes/arrays.php
msgid "Time Out"
msgstr "Ukuphela Kwesikhathi"

#: includes/arrays.php
msgid "How many seconds to allow the page to timeout before reporting it as down."
msgstr "Mingaki imizuzwana okufanele ikhasi livunyelwe ukuphelelwa yisikhathi ngaphambi kokulibika njengeliphansi."

#: includes/arrays.php
msgid "Verification Strings"
msgstr "Imicu Yokuqinisekisa"

#: includes/arrays.php
msgid "Response Search String"
msgstr "Uchungechunge Lokusesha Impendulo"

#: includes/arrays.php
msgid "This is the string to search for in the URL response for a live and working Web Service."
msgstr "Lena intambo okufanele iseshwe empendulweni ye-URL ukuze kutholakale i-Web Service esebenzayo futhi ephilayo."

#: includes/arrays.php
msgid "Response Search String - Maintenance Page"
msgstr "Uchungechunge Lokusesha Impendulo - Ikhasi Lokulungiswa"

#: includes/arrays.php
msgid "This is the string to search for on the Maintenance Page.  The Service Check will check for this string if the above string is not found.  If found, it means that the Web Service is under maintenance."
msgstr "Lena intambo okufanele iseshwe ekhasini Lokulungisa.  Ukuhlolwa Kwesevisi kuzohlola le ntambo uma intambo engenhla ingatholakali.  Uma itholakala, kusho ukuthi i-Web Service isalungiswa."

#: includes/arrays.php
msgid "Response Search String - Failed"
msgstr "Uchungechunge Lokusesha Impendulo - Kwehlulekile"

#: includes/arrays.php
msgid "This is the string to search for a known failure in the Web Service response.  The Service Check will only alert if this string is found, ignoring any timeout issues and the search strings above."
msgstr "Lena intambo okufanele iseshwe ukuze kutholakale ukwehluleka okwaziwayo empendulweni ye-Web Service.  Ukuhlolwa Kwesevisi kuzoveza i-alamu kuphela uma le ntambo itholakala, kuziba noma yiziphi izinkinga zokuphela kwesikhathi nezintambo zokusesha ezingenhla."

#: includes/arrays.php
msgid "Notification Settings"
msgstr "Izilungiselelo Zezaziso"

#: includes/arrays.php
msgid "Notify Format"
msgstr "Ifomethi yokwazisa"

#: includes/arrays.php
msgid "This is the format to use when sending the notification email"
msgstr "Lena yifomethi okufanele isetshenziswe lapho kuthunyelwa i-imeyili yesaziso"

#: includes/arrays.php
msgid "Notification List"
msgstr "Uhlu Lwezaziso"

#: includes/arrays.php
msgid "Use this Notification List for those to be notified when this website goes down."
msgstr "Sebenzisa lolu Hlu Lwezaziso kulabo abazokwaziswa uma le webhusayithi iphansi."

#: includes/arrays.php
msgid "Notify Accounts"
msgstr "Yazisa ama-akhawunti"

#: includes/arrays.php
msgid "This is a listing of accounts that will be notified when this website goes down."
msgstr "Lolu wuhlu lwama-akhawunti azothola isaziso uma le webhusayithi iwa."

#: includes/arrays.php
msgid "Extra Alert Emails"
msgstr "Ama-imeyili Okuxwayisa Engeziwe"

#: includes/arrays.php
msgid "You may specify here extra Emails to receive alerts for this URL (comma separated)"
msgstr "Ungacacisa lapha ama-imeyili engeziwe azothola izixwayiso eziphuthumayo zale URL (ahlukaniswe ngokhefana)"

