#: includes/arrays.php webseer.php webseer_servers.php
msgid "URL"
msgstr "URL"

#: includes/arrays.php
msgid "This is the URL to connect to remote.php on this server."
msgstr "Αυτή είναι η διεύθυνση URL για σύνδεση στο remote.php σε αυτόν τον διακομιστή."

#: includes/arrays.php webseer_servers.php
msgid "Location"
msgstr "Τοποθεσία"

#: includes/arrays.php
msgid "Location of this server"
msgstr "Τοποθεσία αυτού του διακομιστή"

#: includes/arrays.php
msgid "Service Check Name"
msgstr "Όνομα ελέγχου υπηρεσίας"

#: includes/arrays.php
msgid "The name that is displayed for this Service Check, and is included in any Alert notifications."
msgstr "Το όνομα που εμφανίζεται για αυτόν τον έλεγχο υπηρεσίας και περιλαμβάνεται σε τυχόν ειδοποιήσεις συναγερμού."

#: includes/arrays.php webseer.php
msgid "Enable Service Check"
msgstr "Ενεργοποίηση ελέγχου υπηρεσίας"

#: includes/arrays.php
msgid "Uncheck this box to disabled this url from being checked."
msgstr "Αποεπιλέξτε αυτό το πλαίσιο για να απενεργοποιήσετε τον έλεγχο αυτής της διεύθυνσης URL."

#: includes/arrays.php
msgid "The URL to Monitor"
msgstr "Η διεύθυνση URL προς παρακολούθηση"

#: includes/arrays.php
msgid "Enter an IP address to connect to.  Leaving blank will use DNS Resolution instead."
msgstr "Εισαγάγετε μια διεύθυνση IP για σύνδεση. Αν το αφήσετε κενό, θα χρησιμοποιηθεί ανάλυση DNS."

#: includes/arrays.php
msgid "Proxy Server"
msgstr "Διακομιστής διαμεσολάβησης"

#: includes/arrays.php
msgid "If this connection text requires a proxy, select it here.  Otherwise choose 'None'."
msgstr "Εάν αυτό το κείμενο σύνδεσης απαιτεί διακομιστή μεσολάβησης, επιλέξτε τον εδώ. Διαφορετικά επιλέξτε «Κανένας»."

#: includes/arrays.php webseer.php
msgid "None"
msgstr "Κανένα"

#: includes/arrays.php webseer.php
msgid "Compression"
msgstr "Συμπίεση"

#: includes/arrays.php
msgid "What compression does the server require?  Most servers should not need this, but some will not redirect properly without it."
msgstr "Τι συμπίεση απαιτεί ο διακομιστής; Οι περισσότεροι διακομιστές δεν θα τη χρειάζονται, αλλά ορισμένοι δεν θα ανακατευθύνουν σωστά χωρίς αυτή."

#: includes/arrays.php
msgid "Available Checks"
msgstr "Διαθέσιμοι έλεγχοι"

#: includes/arrays.php
msgid "Requires Authentication"
msgstr "Απαιτεί έλεγχο ταυτότητας"

#: includes/arrays.php
msgid "Check this box if the site will normally return a 401 Error as it requires a username and password."
msgstr "Επιλέξτε αυτό το πλαίσιο εάν ο ιστότοπος επιστρέφει κανονικά σφάλμα 401, καθώς απαιτεί όνομα χρήστη και κωδικό πρόσβασης."

#: includes/arrays.php
msgid "Check Certificate"
msgstr "Έλεγχος πιστοποιητικού"

#: includes/arrays.php
msgid "If using SSL, check this box if you want to validate the certificate. Default on, turn off if you the site uses a self-signed certificate."
msgstr "Εάν χρησιμοποιείτε SSL, επιλέξτε αυτό το πλαίσιο εάν θέλετε να επικυρώνεται το πιστοποιητικό. Προεπιλεγμένα ενεργό· απενεργοποιήστε το εάν ο ιστότοπος χρησιμοποιεί αυτοϋπογεγραμμένο πιστοποιητικό."

#: includes/arrays.php
msgid "Notification Timing"
msgstr "Χρονισμός ειδοποιήσεων"

#: includes/arrays.php
msgid "Trigger"
msgstr "Ενεργοποίηση"

#: includes/arrays.php
msgid "How many minutes the URL must be down before it will send an alert.  After an alert is sent, in order for a 'Site Recovering' Email to be send, it must also be up this number of minutes."
msgstr "Πόσα λεπτά πρέπει η διεύθυνση URL να είναι ανενεργή προτού αποσταλεί ειδοποίηση. Αφού αποσταλεί ειδοποίηση, για να σταλεί email «Ανάκτηση ιστότοπου», πρέπει επίσης να παραμείνει ενεργή για αυτόν τον αριθμό λεπτών."

#: includes/arrays.php
msgid "Time Out"
msgstr "Λήξη χρονικού ορίου"

#: includes/arrays.php
msgid "How many seconds to allow the page to timeout before reporting it as down."
msgstr "Πόσα δευτερόλεπτα αναμονής για λήξη χρονικού ορίου της σελίδας προτού αναφερθεί ως ανενεργή."

#: includes/arrays.php
msgid "Verification Strings"
msgstr "Συμβολοσειρές επαλήθευσης"

#: includes/arrays.php
msgid "Response Search String"
msgstr "Συμβολοσειρά αναζήτησης απόκρισης"

#: includes/arrays.php
msgid "This is the string to search for in the URL response for a live and working Web Service."
msgstr "Αυτή είναι η συμβολοσειρά αναζήτησης στην απόκριση του URL για μια ενεργή και λειτουργική υπηρεσία Web."

#: includes/arrays.php
msgid "Response Search String - Maintenance Page"
msgstr "Συμβολοσειρά αναζήτησης απόκρισης - Σελίδα συντήρησης"

#: includes/arrays.php
msgid "This is the string to search for on the Maintenance Page.  The Service Check will check for this string if the above string is not found.  If found, it means that the Web Service is under maintenance."
msgstr "Αυτή είναι η συμβολοσειρά αναζήτησης στη σελίδα συντήρησης. Ο έλεγχος υπηρεσίας θα ελέγξει για αυτή τη συμβολοσειρά εάν δεν βρεθεί η παραπάνω συμβολοσειρά. Εάν βρεθεί, σημαίνει ότι η υπηρεσία Web βρίσκεται υπό συντήρηση."

#: includes/arrays.php
msgid "Response Search String - Failed"
msgstr "Συμβολοσειρά αναζήτησης απόκρισης - Αποτυχία"

#: includes/arrays.php
msgid "This is the string to search for a known failure in the Web Service response.  The Service Check will only alert if this string is found, ignoring any timeout issues and the search strings above."
msgstr "Αυτή είναι η συμβολοσειρά αναζήτησης για μια γνωστή αποτυχία στην απόκριση της υπηρεσίας Web. Ο έλεγχος υπηρεσίας θα ειδοποιεί μόνο εάν βρεθεί αυτή η συμβολοσειρά, αγνοώντας τυχόν ζητήματα λήξης χρονικού ορίου και τις παραπάνω συμβολοσειρές αναζήτησης."

#: includes/arrays.php
msgid "Notification Settings"
msgstr "Ρυθμίσεις ειδοποιήσεων"

#: includes/arrays.php
msgid "Notify Format"
msgstr "Μορφή ειδοποίησης"

#: includes/arrays.php
msgid "This is the format to use when sending the notification email"
msgstr "Αυτή είναι η μορφή που θα χρησιμοποιείται κατά την αποστολή του email ειδοποίησης"

#: includes/arrays.php
msgid "Notification List"
msgstr "Λίστα ειδοποιήσεων"

#: includes/arrays.php
msgid "Use this Notification List for those to be notified when this website goes down."
msgstr "Χρησιμοποιήστε αυτή τη λίστα ειδοποιήσεων για όσους πρέπει να ειδοποιούνται όταν αυτός ο ιστότοπος τεθεί εκτός λειτουργίας."

#: includes/arrays.php
msgid "Notify Accounts"
msgstr "Λογαριασμοί ειδοποίησης"

#: includes/arrays.php
msgid "This is a listing of accounts that will be notified when this website goes down."
msgstr "Αυτή είναι μια λίστα λογαριασμών που θα ειδοποιούνται όταν αυτός ο ιστότοπος καταστεί ανενεργός."

#: includes/arrays.php
msgid "Extra Alert Emails"
msgstr "Επιπλέον διευθύνσεις email ειδοποιήσεων"

#: includes/arrays.php
msgid "You may specify here extra Emails to receive alerts for this URL (comma separated)"
msgstr "Μπορείτε να ορίσετε εδώ επιπλέον διευθύνσεις email για τη λήψη ειδοποιήσεων για αυτό το URL (διαχωρισμένες με κόμμα)"

