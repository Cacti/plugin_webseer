msgstr "ይህ ድር ጣቢያ ሲቋረጥ ማሳወቂያ የሚደርሳቸው መለያዎች ዝርዝር ነው።"

#: includes/arrays.php
msgid "Extra Alert Emails"
msgstr "ተጨማሪ የማንቂያ ኢሜይሎች"

#: includes/arrays.php
