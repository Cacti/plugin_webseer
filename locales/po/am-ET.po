msgstr "ይህን አገልጋይ እንደ ዋና አገልጋይ ያዘጋጃል። ዋናው አገልጋይ ሁሉንም የኢሜይል ክንውኖች ያስተናግዳል"

#: includes/arrays.php webseer_servers.php
msgid "IP Address"
msgstr "የIP አድራሻ"

#: includes/arrays.php
msgid "IP Address to connect to this server"
msgstr "ከዚህ አገልጋይ ጋር ለመገናኘት የሚያገለግል IP አድራሻ"

#: includes/arrays.php webseer.php webseer_servers.php
msgid "URL"
msgstr "URL"

#: includes/arrays.php
msgid "This is the URL to connect to remote.php on this server."
msgstr "ይህ በዚህ አገልጋይ ላይ ከremote.php ጋር ለመገናኘት የሚያገለግል URL ነው።"

#: includes/arrays.php webseer_servers.php
msgid "Location"
msgstr "ቦታ"

#: includes/arrays.php
msgid "Location of this server"
msgstr "የዚህ አገልጋይ መገኛ"

#: includes/arrays.php
msgid "Service Check Name"
msgstr "የአገልግሎት ፍተሻ ስም"

#: includes/arrays.php
msgid "The name that is displayed for this Service Check, and is included in any Alert notifications."
msgstr "ለዚህ የአገልግሎት ፍተሻ የሚታየው እና በማንኛውም የማንቂያ ማሳወቂያዎች ውስጥ የሚካተተው ስም።"

#: includes/arrays.php webseer.php
msgid "Enable Service Check"
msgstr "የአገልግሎት ፍተሻን አንቃ"

#: includes/arrays.php
msgid "Uncheck this box to disabled this url from being checked."
msgstr "ይህ URL እንዳይፈተሽ ለማሰናከል የዚህን ሳጥን ምልክት ያንሱ።"

#: includes/arrays.php
msgid "The URL to Monitor"
msgstr "ክትትል የሚደረግበት URL"

#: includes/arrays.php
msgid "Enter an IP address to connect to.  Leaving blank will use DNS Resolution instead."
msgstr "የሚገናኙበትን IP አድራሻ ያስገቡ።  ባዶ መተው በምትኩ DNS አፈታትን ይጠቀማል።"

#: includes/arrays.php
msgid "Proxy Server"
msgstr "ተኪ አገልጋይ"

#: includes/arrays.php
msgid "If this connection text requires a proxy, select it here.  Otherwise choose 'None'."
msgstr "ይህ የግንኙነት ጽሑፍ ፕሮክሲ የሚፈልግ ከሆነ፣ እዚህ ይምረጡት። አለበለዚያ 'None' ይምረጡ።"

#: includes/arrays.php webseer.php
msgid "None"
msgstr "ምንም"

#: includes/arrays.php webseer.php
msgid "Compression"
msgstr "መጭመቅ"

#: includes/arrays.php
msgid "What compression does the server require?  Most servers should not need this, but some will not redirect properly without it."
msgstr "አገልጋዩ ምን ዓይነት መጭመቂያ ይፈልጋል? አብዛኛዎቹ አገልጋዮች ይህን አይፈልጉም፣ ነገር ግን አንዳንዶቹ ያለ እሱ በትክክል አይመሩም።"

#: includes/arrays.php
msgid "Available Checks"
msgstr "ያሉ ፍተሻዎች"

#: includes/arrays.php
msgid "Requires Authentication"
msgstr "ማረጋገጫ ያስፈልገዋል"

#: includes/arrays.php
msgid "Check this box if the site will normally return a 401 Error as it requires a username and password."
msgstr "ጣቢያው የተጠቃሚ ስም እና የይለፍ ቃል ስለሚጠይቅ በተለምዶ 401 ስህተት የሚመልስ ከሆነ ይህን ሳጥን ይምረጡ።"

#: includes/arrays.php
msgid "Check Certificate"
msgstr "የምስክር ወረቀት አረጋግጥ"

#: includes/arrays.php
msgid "If using SSL, check this box if you want to validate the certificate. Default on, turn off if you the site uses a self-signed certificate."
msgstr "SSLን የሚጠቀሙ ከሆነ፣ የምስክር ወረቀቱን ማረጋገጥ ከፈለጉ ይህን ሳጥን ይምረጡ። በነባሪ በርቷል፣ ጣቢያው በራሱ የተፈረመ የምስክር ወረቀት የሚጠቀም ከሆነ ያጥፉት።"

#: includes/arrays.php
msgid "Notification Timing"
msgstr "የማሳወቂያ ጊዜ አጠባበቅ"

#: includes/arrays.php
msgid "Trigger"
msgstr "ቀስቃሽ"

#: includes/arrays.php
msgid "How many minutes the URL must be down before it will send an alert.  After an alert is sent, in order for a 'Site Recovering' Email to be send, it must also be up this number of minutes."
msgstr "ማንቂያ ከመላኩ በፊት URL ለስንት ደቂቃዎች መውረድ አለበት። ማንቂያ ከተላከ በኋላ 'ጣቢያ በማገገም ላይ' ኢሜይል እንዲላክ ደግሞ ለዚህን ያህል ደቂቃዎች መስራት አለበት።"

#: includes/arrays.php
msgid "Time Out"
msgstr "የጊዜ ማለቅ"

#: includes/arrays.php
msgid "How many seconds to allow the page to timeout before reporting it as down."
msgstr "ገጹ እንደወረደ ሪፖርት ከመደረጉ በፊት የጊዜ ማብቂያው ለስንት ሰከንዶች እንዲፈቀድ።"

#: includes/arrays.php
msgid "Verification Strings"
msgstr "የማረጋገጫ ሕብረቁምፊዎች"

#: includes/arrays.php
msgid "Response Search String"
msgstr "የምላሽ ፍለጋ ሕብረቁምፊ"

#: includes/arrays.php
msgid "This is the string to search for in the URL response for a live and working Web Service."
msgstr "ይህ ቀጥታ እና በመሥራት ላይ ላለ የድር አገልግሎት በURL ምላሽ ውስጥ የሚፈለግ ሕብረቁምፊ ነው።"

#: includes/arrays.php
msgid "Response Search String - Maintenance Page"
msgstr "የምላሽ ፍለጋ ሕብረቁምፊ - የጥገና ገጽ"

#: includes/arrays.php
msgid "This is the string to search for on the Maintenance Page.  The Service Check will check for this string if the above string is not found.  If found, it means that the Web Service is under maintenance."
msgstr "ይህ በጥገና ገጹ ላይ የሚፈለግ ሕብረቁምፊ ነው። ከላይ ያለው ሕብረቁምፊ ካልተገኘ የአገልግሎት ፍተሻው ይህን ሕብረቁምፊ ይፈትሻል። ከተገኘ የድር አገልግሎቱ በጥገና ላይ ነው ማለት ነው።"

#: includes/arrays.php
msgid "Response Search String - Failed"
msgstr "የምላሽ ፍለጋ ሕብረቁምፊ - አልተሳካም"

#: includes/arrays.php
msgid "This is the string to search for a known failure in the Web Service response.  The Service Check will only alert if this string is found, ignoring any timeout issues and the search strings above."
msgstr "ይህ በድር አገልግሎት ምላሽ ውስጥ የታወቀ ውድቀትን ለመፈለግ የሚያገለግል ሕብረቁምፊ ነው። የአገልግሎት ፍተሻው የጊዜ ማለፊያ ችግሮችን እና ከላይ ያሉትን የፍለጋ ሕብረቁምፊዎች ችላ በማለት ይህ ሕብረቁምፊ ከተገኘ ብቻ ያሳውቃል።"

#: includes/arrays.php
msgid "Notification Settings"
msgstr "የማሳወቂያ ቅንብሮች"

#: includes/arrays.php
