#: includes/arrays.php webseer_servers.php
msgid "Enable Server"
msgid_plural "Enable Servers"
msgstr[0] "Hawlgeli Adeegaha"
msgstr[1] "Hawlgeli Adeegayaasha"

#: includes/arrays.php
msgid "Uncheck this box to disabled this server from checking urls."
msgstr "Ka saar calaamadda sanduuqan si aad u joojiso in adeegahani hubiyo URL-yada."

#: includes/arrays.php
msgid "Is this server the local server?"
msgstr "Server-kan ma yahay server-ka maxalliga ah?"

#: includes/arrays.php
msgid "Check this box if the current server you are connected to is this entry."
msgstr "Calaamadee sanduuqan haddii server-ka hadda aad ku xiran tahay uu yahay gelitaankan."

#: includes/arrays.php
msgid "Master Server"
msgstr "Adeegaha Aasaasiga ah"

#: includes/arrays.php
msgid "Sets this server to the Master server.  The Master server handles all Email operations"
msgstr "Wuxuu server-kan u dejiyaa inuu noqdo server-ka Master.  Server-ka Master wuxuu maamulaa dhammaan hawlgallada Iimaylka"

#: includes/arrays.php webseer_servers.php
msgid "IP Address"
msgstr "Ciwaanka IP"

#: includes/arrays.php
msgid "IP Address to connect to this server"
msgstr "Ciwaanka IP ee lagula xiriiro server-kan"

#: includes/arrays.php webseer.php webseer_servers.php
msgid "URL"
msgstr "URL"

#: includes/arrays.php
msgid "This is the URL to connect to remote.php on this server."
msgstr "Kani waa URL-ka lagu xiro remote.php ee adeegahan ku yaal."

#: includes/arrays.php webseer_servers.php
msgid "Location"
msgstr "Goobta"

#: includes/arrays.php
msgid "Location of this server"
msgstr "Goobta adeegahan"

#: includes/arrays.php
msgid "Service Check Name"
msgstr "Magaca Hubinta Adeegga"

#: includes/arrays.php
msgid "The name that is displayed for this Service Check, and is included in any Alert notifications."
msgstr "Magaca loo soo bandhigo Hubintan Adeegga, laguna daro ogeysiisyada qaylo-dhaanta kasta."

#: includes/arrays.php webseer.php
msgid "Enable Service Check"
msgstr "Hawlgeli Hubinta Adeegga"

#: includes/arrays.php
msgid "Uncheck this box to disabled this url from being checked."
msgstr "Ka saar calaamadda sanduuqan si aad u joojiso hubinta URL-kan."

#: includes/arrays.php
msgid "The URL to Monitor"
msgstr "URL-ka la kormeerayo"

#: includes/arrays.php
msgid "Enter an IP address to connect to.  Leaving blank will use DNS Resolution instead."
msgstr "Geli ciwaanka IP si loogu xirmo. Bannaanka oo loo daayo waxaa la adeegsan doonaa Xallinta DNS."

#: includes/arrays.php
msgid "Proxy Server"
msgstr "Adeegaha Wakiilka (Proxy)"

#: includes/arrays.php
msgid "If this connection text requires a proxy, select it here.  Otherwise choose 'None'."
msgstr "Haddii qoraalkan isku xirku uu u baahan yahay wakiil (proxy), halkan ka dooro. Haddii kale dooro 'Midna'."

#: includes/arrays.php webseer.php
msgid "None"
msgstr "Midna"

#: includes/arrays.php webseer.php
msgid "Compression"
msgstr "Cadaadis"

#: includes/arrays.php
msgid "What compression does the server require?  Most servers should not need this, but some will not redirect properly without it."
msgstr "Cadaadis noocee ah ayuu adeeguhu u baahan yahay?  Adeegayaasha badankood uma baahna tan, laakiin qaarkood si sax ah uma leexin doonaan iyada la'aanteed."

#: includes/arrays.php
msgid "Available Checks"
msgstr "Hubinnada la heli karo"

#: includes/arrays.php
msgid "Requires Authentication"
msgstr "Wuxuu U Baahan Yahay Xaqiijin"

#: includes/arrays.php
msgid "Check this box if the site will normally return a 401 Error as it requires a username and password."
msgstr "Calaamadee sanduuqan haddii goobta ay caadiyan soo celiso Khalad 401 ah maadaama ay u baahan tahay magaca isticmaalaha iyo erayga sirta ah."

#: includes/arrays.php
msgid "Check Certificate"
msgstr "Hubi Shahaadada"

#: includes/arrays.php
msgid "If using SSL, check this box if you want to validate the certificate. Default on, turn off if you the site uses a self-signed certificate."
msgstr "Haddii la isticmaalayo SSL, calaamadee sanduuqan haddii aad rabto inaad xaqiijiso shahaadada. Sida caadiga ah way shidan tahay, dami haddii Goobtu ay isticmaasho shahaado ay iyadu iska saxeexday."

#: includes/arrays.php
msgid "Notification Timing"
msgstr "Wakhtiga Ogeysiiska"

#: includes/arrays.php
msgid "Trigger"
msgstr "Kiciye"

#: includes/arrays.php
msgid "How many minutes the URL must be down before it will send an alert.  After an alert is sent, in order for a 'Site Recovering' Email to be send, it must also be up this number of minutes."
msgstr "Immisa daqiiqo ayay tahay in URL-ku maqnaado ka hor inta uusan dirin digniin. Ka dib marka digniin la diro, si loo diro Iimayl 'Goobta Soo Kabanaysa', waa inuu sidoo kale shaqeeyaa tiradaas daqiiqadaha ah."

#: includes/arrays.php
msgid "Time Out"
msgstr "Waqti Dhammaad"

#: includes/arrays.php
msgid "How many seconds to allow the page to timeout before reporting it as down."
msgstr "Immisa ilbiriqsi ayaa loo oggolaanayaa bogga ka hor inta uusan waqtigu ka dhicin si loo soo sheego inuu maqan yahay."

#: includes/arrays.php
msgid "Verification Strings"
msgstr "Xarfaha Xaqiijinta"

#: includes/arrays.php
msgid "Response Search String"
msgstr "Xarigga Raadinta Jawaabta"

#: includes/arrays.php
msgid "This is the string to search for in the URL response for a live and working Web Service."
msgstr "Kani waa xarfo-taxaha laga raadinayo jawaabta URL ee Adeeg Web oo nool oo shaqeynaya."

#: includes/arrays.php
msgid "Response Search String - Maintenance Page"
msgstr "Xarigga Raadinta Jawaabta - Bogga Dayactirka"

#: includes/arrays.php
msgid "This is the string to search for on the Maintenance Page.  The Service Check will check for this string if the above string is not found.  If found, it means that the Web Service is under maintenance."
msgstr "Kani waa xarfo-taxaha laga raadinayo Bogga Dayactirka. Hubinta Adeeggu waxay eegi doontaa xarfo-taxahan haddii aan la helin xarfo-taxaha sare. Haddii la helo, waxay ka dhigan tahay in Adeegga Webku uu ku jiro dayactir."

#: includes/arrays.php
msgid "Response Search String - Failed"
msgstr "Xarigga Raadinta Jawaabta - Wuu Fashilmay"

#: includes/arrays.php
msgid "This is the string to search for a known failure in the Web Service response.  The Service Check will only alert if this string is found, ignoring any timeout issues and the search strings above."
msgstr "Kani waa xarfo-taxaha laga raadinayo fashil la yaqaan oo ku jira jawaabta Adeegga Webka. Hubinta Adeeggu waxay qaylo-dhaan bixin doontaa oo keliya haddii xarfo-taxahan la helo, iyadoo iska indha tiraysa arrimaha wakhti-dhammaadka iyo xarfo-taxayaasha raadinta ee sare."

#: includes/arrays.php
msgid "Notification Settings"
msgstr "Dejinta Ogeysiisyada"

#: includes/arrays.php
msgid "Notify Format"
msgstr "Qaabka Ogeysiiska"

#: includes/arrays.php
msgid "This is the format to use when sending the notification email"
msgstr "Kani waa qaabka loo adeegsado marka la dirayo iimaylka ogeysiiska"

#: includes/arrays.php
msgid "Notification List"
msgstr "Liiska Ogeysiiska"

#: includes/arrays.php
msgid "Use this Notification List for those to be notified when this website goes down."
msgstr "U isticmaal Liiskan Ogeysiiska kuwa la ogeysiinayo marka degelkani istaago."

#: includes/arrays.php
msgid "Notify Accounts"
msgstr "Ogeysii Akoonnada"

#: includes/arrays.php
msgid "This is a listing of accounts that will be notified when this website goes down."
msgstr "Kani waa liiska koontooyinka la ogeysiin doono marka boggani shaqada joojiyo."

#: includes/arrays.php
msgid "Extra Alert Emails"
msgstr "Iimayllada Digniinta Dheeraadka ah"

#: includes/arrays.php
msgid "You may specify here extra Emails to receive alerts for this URL (comma separated)"
msgstr "Waxaad halkan ku cayimi kartaa Iimayllo dheeraad ah si ay u helaan qaylo-dhaanta URL-kan (kooma ku kala saar)"

