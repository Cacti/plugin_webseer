msgid "The name that is displayed for this Service Check, and is included in any Alert notifications."
msgstr "השם המוצג עבור בדיקת שירות זו, ונכלל בכל הודעות ההתראה."

#: includes/arrays.php webseer.php
msgid "Enable Service Check"
msgstr "הפעל בדיקת שירות"

#: includes/arrays.php
msgid "Uncheck this box to disabled this url from being checked."
msgstr "בטל את סימון תיבה זו כדי להשבית את בדיקת כתובת ה-URL הזו."

#: includes/arrays.php
msgid "The URL to Monitor"
msgstr "כתובת ה-URL לניטור"

#: includes/arrays.php
msgid "Enter an IP address to connect to.  Leaving blank will use DNS Resolution instead."
msgstr "הזן כתובת IP להתחברות אליה. השארת שדה זה ריק תשתמש בפענוח DNS רגיל."

#: includes/arrays.php
msgid "Proxy Server"
msgstr "שרת פרוקסי"

#: includes/arrays.php
msgid "If this connection text requires a proxy, select it here.  Otherwise choose 'None'."
msgstr "אם טקסט חיבור זה דורש שרת proxy, בחר אותו כאן. אחרת בחר 'ללא'."

#: includes/arrays.php webseer.php
msgid "None"
msgstr "ללא"

#: includes/arrays.php webseer.php
msgid "Compression"
msgstr "דחיסה"

#: includes/arrays.php
msgid "What compression does the server require?  Most servers should not need this, but some will not redirect properly without it."
msgstr "איזו דחיסה השרת דורש? רוב השרתים אינם זקוקים לכך, אך חלקם לא יבצעו הפניה מחדש כראוי בלעדיה."

#: includes/arrays.php
msgid "Available Checks"
msgstr "בדיקות זמינות"

#: includes/arrays.php
msgid "Requires Authentication"
msgstr "מסמכים נדרשים"

#: includes/arrays.php
msgid "Check this box if the site will normally return a 401 Error as it requires a username and password."
msgstr "סמן תיבה זו אם האתר מחזיר בדרך כלל שגיאת 401 מכיוון שהוא דורש שם משתמש וסיסמה."

#: includes/arrays.php
msgid "Check Certificate"
msgstr "בדוק תעודה"

#: includes/arrays.php
msgid "If using SSL, check this box if you want to validate the certificate. Default on, turn off if you the site uses a self-signed certificate."
msgstr "אם משתמשים ב-SSL, סמן תיבה זו אם ברצונך לאמת את האישור. פעיל כברירת מחדל; כבה אם האתר משתמש באישור בחתימה עצמית."

#: includes/arrays.php
msgid "Notification Timing"
msgstr "תזמון התראות"

#: includes/arrays.php
msgid "Trigger"
msgstr "טריגר"

#: includes/arrays.php
msgid "How many minutes the URL must be down before it will send an alert.  After an alert is sent, in order for a 'Site Recovering' Email to be send, it must also be up this number of minutes."
msgstr "כמה דקות כתובת ה-URL חייבת להיות לא פעילה לפני שתישלח התראה. לאחר שליחת התראה, כדי שיישלח דוא\"ל 'התאוששות אתר', עליה להיות פעילה גם במשך מספר דקות זה."

#: includes/arrays.php
msgid "Time Out"
msgstr "פסק זמן"

#: includes/arrays.php
msgid "How many seconds to allow the page to timeout before reporting it as down."
msgstr "כמה שניות להמתין לזמן קצוב של הדף לפני דיווחו כלא פעיל."

#: includes/arrays.php
msgid "Verification Strings"
msgstr "מחרוזות אימות"

#: includes/arrays.php
msgid "Response Search String"
msgstr "מחרוזת חיפוש בתגובה"

#: includes/arrays.php
msgid "This is the string to search for in the URL response for a live and working Web Service."
msgstr "זוהי המחרוזת לחיפוש בתגובת כתובת ה-URL עבור שירות אינטרנט פעיל ותקין."

#: includes/arrays.php
msgid "Response Search String - Maintenance Page"
msgstr "מחרוזת חיפוש בתגובה - דף תחזוקה"

#: includes/arrays.php
msgid "This is the string to search for on the Maintenance Page.  The Service Check will check for this string if the above string is not found.  If found, it means that the Web Service is under maintenance."
msgstr "זוהי המחרוזת לחיפוש בדף התחזוקה. בדיקת השירות תבדוק מחרוזת זו אם המחרוזת שלמעלה לא נמצאה. אם היא נמצאת, המשמעות היא ששירות האינטרנט נמצא בתחזוקה."

#: includes/arrays.php
msgid "Response Search String - Failed"
msgstr "מחרוזת חיפוש בתגובה - נכשל"

#: includes/arrays.php
msgid "This is the string to search for a known failure in the Web Service response.  The Service Check will only alert if this string is found, ignoring any timeout issues and the search strings above."
msgstr "זוהי המחרוזת לחיפוש כשל ידוע בתגובת שירות האינטרנט. בדיקת השירות תתריע רק אם מחרוזת זו תימצא, תוך התעלמות מבעיות זמן קצוב וממחרוזות החיפוש שלמעלה."

#: includes/arrays.php
msgid "Notification Settings"
msgstr "הגדרות התראות"

#: includes/arrays.php
msgid "Notify Format"
msgstr "פורמט התראה"

#: includes/arrays.php
msgid "This is the format to use when sending the notification email"
msgstr "זהו הפורמט לשימוש בעת שליחת דוא\"ל ההתראה"

#: includes/arrays.php
msgid "Notification List"
msgstr "רשימת התראות"

#: includes/arrays.php
msgid "Use this Notification List for those to be notified when this website goes down."
msgstr "השתמש ברשימת התראות זו עבור מי שיקבל התראה כאשר אתר זה יהפוך ללא פעיל."

#: includes/arrays.php
msgid "Notify Accounts"
msgstr "חשבונות להתראה"

#: includes/arrays.php
msgid "This is a listing of accounts that will be notified when this website goes down."
msgstr "זוהי רשימת החשבונות שיקבלו התראה כאשר אתר זה הופך ללא פעיל."

#: includes/arrays.php
msgid "Extra Alert Emails"
msgstr "כתובות דוא\"ל נוספות להתראות"

#: includes/arrays.php
msgid "You may specify here extra Emails to receive alerts for this URL (comma separated)"
msgstr "ניתן לציין כאן כתובות דוא\"ל נוספות לקבלת התראות עבור כתובת URL זו (מופרדות בפסיק)"

