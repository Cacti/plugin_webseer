msgstr "סמן תיבה זו אם השרת הנוכחי שאליו אתה מחובר הוא רשומה זו."

#: includes/arrays.php
msgid "Master Server"
msgstr "שרת ראשי"

#: includes/arrays.php
msgid "Sets this server to the Master server.  The Master server handles all Email operations"
