#: includes/arrays.php webseer_servers.php
msgid "Location"
msgstr "Ebe Ọ Nọ"

#: includes/arrays.php
msgid "Location of this server"
msgstr "Ebe sava a dị"

#: includes/arrays.php
msgid "Service Check Name"
msgstr "Aha Nnyocha Ọrụ"

#: includes/arrays.php
msgid "The name that is displayed for this Service Check, and is included in any Alert notifications."
msgstr "Aha a na-egosipụta maka Nyocha Ọrụ a, ma gụnye ya na ọkwa Ncheta ọ bụla."

#: includes/arrays.php webseer.php
msgid "Enable Service Check"
msgstr "Gbanye Nlele Ọrụ"

#: includes/arrays.php
msgid "Uncheck this box to disabled this url from being checked."
msgstr "Wepụ akara n'igbe a iji gbanyụọ URL a ka a ghara ilele ya."

#: includes/arrays.php
msgid "The URL to Monitor"
msgstr "URL a ga-enyocha"

#: includes/arrays.php
msgid "Enter an IP address to connect to.  Leaving blank will use DNS Resolution instead."
msgstr "Tinye adreesị IP iji jikọọ na ya.  Ịhapụ oghere ga-eji Mkpebi DNS kama."

#: includes/arrays.php
msgid "Proxy Server"
msgstr "Sava Proxy"

#: includes/arrays.php
msgid "If this connection text requires a proxy, select it here.  Otherwise choose 'None'."
msgstr "Ọ bụrụ na ederede njikọ a chọrọ proxy, họrọ ya ebe a.  Ma ọ bụghị ya họrọ 'Ọ dịghị'."

#: includes/arrays.php webseer.php
msgid "None"
msgstr "Ọ Dịghị Nke Ọ Bụla"

#: includes/arrays.php webseer.php
msgid "Compression"
msgstr "Nkpakọ"

#: includes/arrays.php
msgid "What compression does the server require?  Most servers should not need this, but some will not redirect properly without it."
msgstr "Kedu mkpakọ sava ahụ chọrọ?  Ọtụtụ sava ekwesịghị ịchọ nke a, mana ụfọdụ agaghị ebugharị nke ọma na-enweghị ya."

#: includes/arrays.php
msgid "Available Checks"
msgstr "Nlele Ndị Dị"

#: includes/arrays.php
msgid "Requires Authentication"
msgstr "Chọrọ Nkwenye Njirimara"

#: includes/arrays.php
msgid "Check this box if the site will normally return a 401 Error as it requires a username and password."
msgstr "Kaa akara n'igbe a ma ọ bụrụ na saịtị ahụ na-eweghachi Njehie 401 n'ihi na ọ chọrọ aha njirimara na okwuntụghe."

#: includes/arrays.php
msgid "Check Certificate"
msgstr "Lelee Asambodo"

#: includes/arrays.php
msgid "If using SSL, check this box if you want to validate the certificate. Default on, turn off if you the site uses a self-signed certificate."
msgstr "Ọ bụrụ na ị na-eji SSL, kaa igbe a akara ma ọ bụrụ na ịchọrọ ịkwado asambodo ahụ. Gbanyere na ndabara, gbanyụọ ma ọ bụrụ na saịtị ahụ na-eji asambodo bịanyere aka n'onwe ya."

#: includes/arrays.php
msgid "Notification Timing"
msgstr "Ịtụ Oge Ọkwa"

#: includes/arrays.php
msgid "Trigger"
msgstr "Mkpali"

#: includes/arrays.php
msgid "How many minutes the URL must be down before it will send an alert.  After an alert is sent, in order for a 'Site Recovering' Email to be send, it must also be up this number of minutes."
msgstr "Nkeji ole ka URL ga-anọ ala tupu ya eziga ọkwa mgbaama.  Mgbe e zigara ọkwa mgbaama, ka e wee ziga Ozi-e 'Saịtị Na-agbake', ọ ga-adịkwa elu ọnụ ọgụgụ nkeji a."

#: includes/arrays.php
msgid "Time Out"
msgstr "Oge Agwụla"

#: includes/arrays.php
msgid "How many seconds to allow the page to timeout before reporting it as down."
msgstr "Sekọnd ole ka a ga-ekwe ka ibe gafee oge tupu e kwupụta na ọ dara."

#: includes/arrays.php
msgid "Verification Strings"
msgstr "Eriri Nkwenye"

#: includes/arrays.php
msgid "Response Search String"
msgstr "Eriri Ọchụchọ Nzaghachi"

#: includes/arrays.php
msgid "This is the string to search for in the URL response for a live and working Web Service."
msgstr "Nke a bụ eriri ederede a ga-achọ na nzaghachi URL maka Ọrụ Weebụ dị ndụ ma na-arụ ọrụ."

#: includes/arrays.php
msgid "Response Search String - Maintenance Page"
msgstr "Eriri Ọchụchọ Nzaghachi - Ibe Ndozi"

#: includes/arrays.php
msgid "This is the string to search for on the Maintenance Page.  The Service Check will check for this string if the above string is not found.  If found, it means that the Web Service is under maintenance."
msgstr "Nke a bụ eriri ederede a ga-achọ na Peeji Ndozi. Nnyocha Ọrụ ga-elele maka eriri ederede a ma ọ bụrụ na ahụghị eriri dị n'elu. Ọ bụrụ na a hụ ya, ọ pụtara na a na-edozi Ọrụ Weebụ ahụ."

#: includes/arrays.php
msgid "Response Search String - Failed"
msgstr "Eriri Ọchụchọ Nzaghachi - Dara"

#: includes/arrays.php
msgid "This is the string to search for a known failure in the Web Service response.  The Service Check will only alert if this string is found, ignoring any timeout issues and the search strings above."
msgstr "Nke a bụ eriri ederede a ga-achọ maka ọdịda a maara na nzaghachi Ọrụ Weebụ. Nnyocha Ọrụ ga-enye ọkwa naanị ma ọ bụrụ na a hụrụ eriri ederede a, na-eleghara nsogbu nkwụsị oge na eriri nchọta dị n'elu anya."

#: includes/arrays.php
msgid "Notification Settings"
msgstr "Ntọala Ọkwa"

#: includes/arrays.php
msgid "Notify Format"
msgstr "Ụdị Ọkwa"

#: includes/arrays.php
msgid "This is the format to use when sending the notification email"
msgstr "Nke a bụ usoro a ga-eji mgbe a na-ezipu ozi-e ọkwa"

#: includes/arrays.php
msgid "Notification List"
msgstr "Ndepụta Ọkwa"

#: includes/arrays.php
msgid "Use this Notification List for those to be notified when this website goes down."
msgstr "Jiri Ndepụta Ọkwa a maka ndị a ga-agwa mgbe weebụsaịtị a dara."

#: includes/arrays.php
msgid "Notify Accounts"
msgstr "Gwa Akaụntụ"

#: includes/arrays.php
msgid "This is a listing of accounts that will be notified when this website goes down."
msgstr "Nke a bụ ndepụta akaụntụ a ga-agwa mgbe weebụsaịtị a kwụsịrị."

#: includes/arrays.php
msgid "Extra Alert Emails"
msgstr "Ozi-e Mkpọku Mgbakwunye"

#: includes/arrays.php
msgid "You may specify here extra Emails to receive alerts for this URL (comma separated)"
msgstr "Ị nwere ike ịkọwapụta Ozi-e ndị ọzọ ebe a iji nata mkpu maka URL a (e jiri rikọm kewaa)"

