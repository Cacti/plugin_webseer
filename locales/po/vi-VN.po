#: includes/arrays.php
msgid "Uncheck this box to disabled this server from checking urls."
msgstr "Bỏ chọn ô này để tắt việc kiểm tra URL trên máy chủ này."

#: includes/arrays.php
msgid "Is this server the local server?"
msgstr "Đây có phải là máy chủ cục bộ không?"

#: includes/arrays.php
msgid "Check this box if the current server you are connected to is this entry."
msgstr "Chọn hộp này nếu máy chủ hiện tại bạn đang kết nối là mục này."

#: includes/arrays.php
msgid "Master Server"
msgstr "Máy chủ chính"

#: includes/arrays.php
msgid "Sets this server to the Master server.  The Master server handles all Email operations"
msgstr "Đặt máy chủ này làm máy chủ chính. Máy chủ chính xử lý tất cả các tác vụ Email"

#: includes/arrays.php webseer_servers.php
msgid "IP Address"
msgstr "Địa chỉ IP"

#: includes/arrays.php
msgid "IP Address to connect to this server"
msgstr "Địa chỉ IP để kết nối tới máy chủ này"

#: includes/arrays.php webseer.php webseer_servers.php
msgid "URL"
msgstr "URL"

#: includes/arrays.php
msgid "This is the URL to connect to remote.php on this server."
msgstr "Đây là URL để kết nối đến remote.php trên máy chủ này."

#: includes/arrays.php webseer_servers.php
msgid "Location"
msgstr "Vị trí"

#: includes/arrays.php
msgid "Location of this server"
msgstr "Vị trí của máy chủ này"

#: includes/arrays.php
msgid "Service Check Name"
msgstr "Tên kiểm tra dịch vụ"

#: includes/arrays.php
msgid "The name that is displayed for this Service Check, and is included in any Alert notifications."
msgstr "Tên được hiển thị cho Kiểm tra dịch vụ này và được đưa vào mọi thông báo cảnh báo."

#: includes/arrays.php webseer.php
msgid "Enable Service Check"
msgstr "Bật kiểm tra dịch vụ"

#: includes/arrays.php
msgid "Uncheck this box to disabled this url from being checked."
msgstr "Bỏ chọn ô này để tắt việc kiểm tra URL này."

#: includes/arrays.php
msgid "The URL to Monitor"
msgstr "URL cần giám sát"

#: includes/arrays.php
msgid "Enter an IP address to connect to.  Leaving blank will use DNS Resolution instead."
msgstr "Nhập địa chỉ IP để kết nối tới. Để trống sẽ sử dụng phân giải DNS thông thường."

#: includes/arrays.php
msgid "Proxy Server"
msgstr "Proxy server"

#: includes/arrays.php
msgid "If this connection text requires a proxy, select it here.  Otherwise choose 'None'."
msgstr "Nếu chuỗi kết nối này yêu cầu proxy, hãy chọn tại đây. Nếu không, hãy chọn 'Không có'."

#: includes/arrays.php webseer.php
msgid "None"
msgstr "Không"

#: includes/arrays.php webseer.php
msgid "Compression"
msgstr "Nén dữ liệu"

#: includes/arrays.php
msgid "What compression does the server require?  Most servers should not need this, but some will not redirect properly without it."
msgstr "Máy chủ yêu cầu phương thức nén nào? Hầu hết các máy chủ không cần tùy chọn này, nhưng một số sẽ không chuyển hướng đúng cách nếu thiếu nó."

#: includes/arrays.php
msgid "Available Checks"
msgstr "Các kiểm tra khả dụng"

#: includes/arrays.php
msgid "Requires Authentication"
msgstr "Yêu cầu xác thực"

#: includes/arrays.php
msgid "Check this box if the site will normally return a 401 Error as it requires a username and password."
msgstr "Chọn hộp này nếu trang web thường trả về Lỗi 401 do yêu cầu tên người dùng và mật khẩu."

#: includes/arrays.php
msgid "Check Certificate"
msgstr "Kiểm tra chứng chỉ"

#: includes/arrays.php
msgid "If using SSL, check this box if you want to validate the certificate. Default on, turn off if you the site uses a self-signed certificate."
msgstr "Nếu sử dụng SSL, hãy chọn hộp kiểm này nếu bạn muốn xác thực chứng chỉ. Mặc định bật; hãy tắt nếu trang web sử dụng chứng chỉ tự ký."

#: includes/arrays.php
msgid "Notification Timing"
msgstr "Thời gian thông báo"

#: includes/arrays.php
msgid "Trigger"
msgstr "Nút kích hoạt"

#: includes/arrays.php
msgid "How many minutes the URL must be down before it will send an alert.  After an alert is sent, in order for a 'Site Recovering' Email to be send, it must also be up this number of minutes."
msgstr "URL phải ngừng hoạt động bao nhiêu phút trước khi gửi cảnh báo. Sau khi cảnh báo được gửi, để gửi email 'Trang web đang khôi phục', URL cũng phải hoạt động trong bấy nhiêu phút."

#: includes/arrays.php
msgid "Time Out"
msgstr "Hết thời gian chờ"

#: includes/arrays.php
msgid "How many seconds to allow the page to timeout before reporting it as down."
msgstr "Số giây tối đa cho phép trang hết thời gian chờ trước khi báo cáo là ngừng hoạt động."

#: includes/arrays.php
msgid "Verification Strings"
msgstr "Chuỗi xác minh"

#: includes/arrays.php
msgid "Response Search String"
msgstr "Chuỗi tìm kiếm phản hồi"

#: includes/arrays.php
msgid "This is the string to search for in the URL response for a live and working Web Service."
msgstr "Đây là chuỗi cần tìm trong phản hồi URL để xác định Dịch vụ Web đang hoạt động bình thường."

#: includes/arrays.php
msgid "Response Search String - Maintenance Page"
msgstr "Chuỗi tìm kiếm phản hồi - Trang bảo trì"

#: includes/arrays.php
msgid "This is the string to search for on the Maintenance Page.  The Service Check will check for this string if the above string is not found.  If found, it means that the Web Service is under maintenance."
msgstr "Đây là chuỗi cần tìm trên Trang Bảo trì. Kiểm tra dịch vụ sẽ kiểm tra chuỗi này nếu không tìm thấy chuỗi ở trên. Nếu tìm thấy, điều đó có nghĩa là Dịch vụ Web đang được bảo trì."

#: includes/arrays.php
msgid "Response Search String - Failed"
msgstr "Chuỗi tìm kiếm phản hồi - Thất bại"

#: includes/arrays.php
msgid "This is the string to search for a known failure in the Web Service response.  The Service Check will only alert if this string is found, ignoring any timeout issues and the search strings above."
msgstr "Đây là chuỗi cần tìm để phát hiện lỗi đã biết trong phản hồi của Dịch vụ Web. Kiểm tra dịch vụ sẽ chỉ cảnh báo nếu tìm thấy chuỗi này, bỏ qua mọi vấn đề hết thời gian chờ và các chuỗi tìm kiếm ở trên."

#: includes/arrays.php
msgid "Notification Settings"
msgstr "Thiết lập Thông báo"

#: includes/arrays.php
msgid "Notify Format"
msgstr "Định dạng thông báo"

#: includes/arrays.php
msgid "This is the format to use when sending the notification email"
msgstr "Đây là định dạng được sử dụng khi gửi email thông báo"

#: includes/arrays.php
msgid "Notification List"
msgstr "Danh sách thông báo"

#: includes/arrays.php
msgid "Use this Notification List for those to be notified when this website goes down."
msgstr "Sử dụng Danh sách thông báo này cho những người sẽ được thông báo khi trang web này ngừng hoạt động."

#: includes/arrays.php
msgid "Notify Accounts"
msgstr "Tài khoản nhận thông báo"

#: includes/arrays.php
msgid "This is a listing of accounts that will be notified when this website goes down."
msgstr "Đây là danh sách các tài khoản sẽ được thông báo khi trang web này ngừng hoạt động."

#: includes/arrays.php
msgid "Extra Alert Emails"
msgstr "Email cảnh báo bổ sung"

#: includes/arrays.php
msgid "You may specify here extra Emails to receive alerts for this URL (comma separated)"
msgstr "Bạn có thể chỉ định thêm các địa chỉ Email tại đây để nhận cảnh báo cho URL này (phân tách bằng dấu phẩy)"

