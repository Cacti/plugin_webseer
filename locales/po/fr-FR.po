#: includes/arrays.php webseer_servers.php
#, fuzzy
msgid "Enable Server"
msgid_plural "Enable Servers"
msgstr[0] "Activer le serveur"
msgstr[1] "Activer le serveur"

#: includes/arrays.php
msgid "Uncheck this box to disabled this server from checking urls."
msgstr "Décochez cette case pour désactiver la vérification des URL par ce serveur."

#: includes/arrays.php
msgid "Is this server the local server?"
msgstr "Ce serveur est-il le serveur local ?"

#: includes/arrays.php
msgid "Check this box if the current server you are connected to is this entry."
msgstr "Cochez cette case si le serveur auquel vous êtes actuellement connecté correspond à cette entrée."

#: includes/arrays.php
msgid "Master Server"
msgstr "Serveur Principal"

#: includes/arrays.php
msgid "Sets this server to the Master server.  The Master server handles all Email operations"
msgstr "Définit ce serveur comme serveur maître. Le serveur maître gère toutes les opérations d'e-mail"

#: includes/arrays.php webseer_servers.php
msgid "IP Address"
msgstr "Adresse IP"

#: includes/arrays.php
msgid "IP Address to connect to this server"
msgstr "Adresse IP pour se connecter à ce serveur"

#: includes/arrays.php webseer.php webseer_servers.php
msgid "URL"
msgstr "URL"

#: includes/arrays.php
msgid "This is the URL to connect to remote.php on this server."
msgstr "Il s'agit de l'URL permettant de se connecter à remote.php sur ce serveur."

#: includes/arrays.php webseer_servers.php
msgid "Location"
msgstr "Emplacement"

#: includes/arrays.php
msgid "Location of this server"
msgstr "Emplacement de ce serveur"

#: includes/arrays.php
msgid "Service Check Name"
msgstr "Nom du contrôle de service"

#: includes/arrays.php
msgid "The name that is displayed for this Service Check, and is included in any Alert notifications."
msgstr "Le nom affiché pour ce contrôle de service et inclus dans toutes les notifications d'alerte."

#: includes/arrays.php webseer.php
msgid "Enable Service Check"
msgstr "Activer la vérification de service"

#: includes/arrays.php
msgid "Uncheck this box to disabled this url from being checked."
msgstr "Décochez cette case pour désactiver la vérification de cette URL."

#: includes/arrays.php
msgid "The URL to Monitor"
msgstr "L'URL à surveiller"

#: includes/arrays.php
msgid "Enter an IP address to connect to.  Leaving blank will use DNS Resolution instead."
msgstr "Saisissez une adresse IP à laquelle se connecter. Laisser vide utilisera la résolution DNS."

#: includes/arrays.php
msgid "Proxy Server"
msgstr "Serveur proxy"

#: includes/arrays.php
msgid "If this connection text requires a proxy, select it here.  Otherwise choose 'None'."
msgstr "Si ce test de connexion nécessite un proxy, sélectionnez-le ici. Sinon, choisissez « Aucun »."

#: includes/arrays.php webseer.php
msgid "None"
msgstr "Aucun"

#: includes/arrays.php webseer.php
msgid "Compression"
msgstr "Compression"

#: includes/arrays.php
msgid "What compression does the server require?  Most servers should not need this, but some will not redirect properly without it."
msgstr "Quelle compression le serveur requiert-il ? La plupart des serveurs ne devraient pas en avoir besoin, mais certains ne redirigeront pas correctement sans elle."

#: includes/arrays.php
msgid "Available Checks"
msgstr "Vérifications disponibles"

#: includes/arrays.php
msgid "Requires Authentication"
msgstr "Nécessite une authentification"

#: includes/arrays.php
msgid "Check this box if the site will normally return a 401 Error as it requires a username and password."
msgstr "Cochez cette case si le site renvoie normalement une erreur 401 car il nécessite un nom d'utilisateur et un mot de passe."

#: includes/arrays.php
msgid "Check Certificate"
msgstr "Vérifier le certificat"

#: includes/arrays.php
msgid "If using SSL, check this box if you want to validate the certificate. Default on, turn off if you the site uses a self-signed certificate."
msgstr "Si vous utilisez SSL, cochez cette case pour valider le certificat. Activé par défaut ; désactivez cette option si le site utilise un certificat auto-signé."

#: includes/arrays.php
msgid "Notification Timing"
msgstr "Délai de notification"

#: includes/arrays.php
msgid "Trigger"
msgstr "Déclencheur"

#: includes/arrays.php
msgid "How many minutes the URL must be down before it will send an alert.  After an alert is sent, in order for a 'Site Recovering' Email to be send, it must also be up this number of minutes."
msgstr "Nombre de minutes pendant lesquelles l'URL doit être inactive avant l'envoi d'une alerte. Après l'envoi d'une alerte, pour qu'un e-mail « Récupération du site » soit envoyé, elle doit également être active pendant ce même nombre de minutes."

#: includes/arrays.php
msgid "Time Out"
msgstr "Expiration"

#: includes/arrays.php
msgid "How many seconds to allow the page to timeout before reporting it as down."
msgstr "Délai d'expiration en secondes accordé à la page avant de la signaler comme inactive."

#: includes/arrays.php
msgid "Verification Strings"
msgstr "Chaînes de vérification"

#: includes/arrays.php
msgid "Response Search String"
msgstr "Chaîne de recherche dans la réponse"

#: includes/arrays.php
msgid "This is the string to search for in the URL response for a live and working Web Service."
msgstr "Il s'agit de la chaîne à rechercher dans la réponse de l'URL pour confirmer que le service Web est actif et fonctionnel."

#: includes/arrays.php
msgid "Response Search String - Maintenance Page"
msgstr "Chaîne de recherche dans la réponse - Page de maintenance"

#: includes/arrays.php
msgid "This is the string to search for on the Maintenance Page.  The Service Check will check for this string if the above string is not found.  If found, it means that the Web Service is under maintenance."
msgstr "Il s'agit de la chaîne à rechercher sur la page de maintenance. La vérification de service recherchera cette chaîne si la chaîne ci-dessus n'est pas trouvée. Si elle est trouvée, cela signifie que le service Web est en maintenance."

#: includes/arrays.php
msgid "Response Search String - Failed"
msgstr "Chaîne de recherche dans la réponse - Échec"

#: includes/arrays.php
msgid "This is the string to search for a known failure in the Web Service response.  The Service Check will only alert if this string is found, ignoring any timeout issues and the search strings above."
msgstr "Il s'agit de la chaîne à rechercher pour détecter un échec connu dans la réponse du service Web. La vérification de service n'alertera que si cette chaîne est trouvée, en ignorant les problèmes de délai d'attente et les chaînes de recherche ci-dessus."

#: includes/arrays.php
msgid "Notification Settings"
msgstr "Paramètres de notification"

#: includes/arrays.php
msgid "Notify Format"
msgstr "Format de notification"

#: includes/arrays.php
msgid "This is the format to use when sending the notification email"
msgstr "Il s'agit du format à utiliser lors de l'envoi de l'e-mail de notification"

#: includes/arrays.php
msgid "Notification List"
msgstr "Liste de notification"

#: includes/arrays.php
msgid "Use this Notification List for those to be notified when this website goes down."
msgstr "Utilisez cette liste de notification pour les destinataires à avertir lorsque ce site Web devient inactif."

#: includes/arrays.php
msgid "Notify Accounts"
msgstr "Comptes à notifier"

#: includes/arrays.php
msgid "This is a listing of accounts that will be notified when this website goes down."
msgstr "Liste des comptes qui seront avertis lorsque ce site web devient inaccessible."

#: includes/arrays.php
msgid "Extra Alert Emails"
msgstr "Adresses e-mail d'alerte supplémentaires"

#: includes/arrays.php
msgid "You may specify here extra Emails to receive alerts for this URL (comma separated)"
msgstr "Vous pouvez spécifier ici des adresses e-mail supplémentaires pour recevoir les alertes concernant cette URL (séparées par des virgules)"

