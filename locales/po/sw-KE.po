#: includes/arrays.php webseer_servers.php
msgid "Enable Server"
msgid_plural "Enable Servers"
msgstr[0] "Washa Seva"
msgstr[1] "Washa Seva"

#: includes/arrays.php
msgid "Uncheck this box to disabled this server from checking urls."
msgstr "Ondoa tiki kwenye kisanduku hiki ili kuzima seva hii isikague URL."

#: includes/arrays.php
msgid "Is this server the local server?"
msgstr "Je, seva hii ni seva ya ndani?"

#: includes/arrays.php
msgid "Check this box if the current server you are connected to is this entry."
msgstr "Tiki kisanduku hiki ikiwa seva ya sasa uliyounganishwa nayo ni ingizo hili."

#: includes/arrays.php
msgid "Master Server"
msgstr "Seva Kuu"

#: includes/arrays.php
msgid "Sets this server to the Master server.  The Master server handles all Email operations"
msgstr "Huweka seva hii kuwa Seva Kuu.  Seva Kuu hushughulikia shughuli zote za Barua Pepe"

#: includes/arrays.php webseer_servers.php
msgid "IP Address"
msgstr "Anwani ya IP"

#: includes/arrays.php
msgid "IP Address to connect to this server"
msgstr "Anwani ya IP ya kuunganisha kwenye seva hii"

#: includes/arrays.php webseer.php webseer_servers.php
msgid "URL"
msgstr "URL"

#: includes/arrays.php
msgid "This is the URL to connect to remote.php on this server."
msgstr "Hii ni URL ya kuunganisha na remote.php kwenye seva hii."

#: includes/arrays.php webseer_servers.php
msgid "Location"
msgstr "Mahali"

#: includes/arrays.php
msgid "Location of this server"
msgstr "Mahali ilipo seva hii"

#: includes/arrays.php
msgid "Service Check Name"
msgstr "Jina la Ukaguzi wa Huduma"

#: includes/arrays.php
msgid "The name that is displayed for this Service Check, and is included in any Alert notifications."
msgstr "Jina linaloonyeshwa kwa Ukaguzi huu wa Huduma, na linajumuishwa katika arifa zozote za Tahadhari."

#: includes/arrays.php webseer.php
msgid "Enable Service Check"
msgstr "Washa Ukaguzi wa Huduma"

#: includes/arrays.php
msgid "Uncheck this box to disabled this url from being checked."
msgstr "Ondoa tiki kwenye kisanduku hiki ili kuzima URL hii isikaguliwe."

#: includes/arrays.php
msgid "The URL to Monitor"
msgstr "URL ya Kufuatilia"

#: includes/arrays.php
msgid "Enter an IP address to connect to.  Leaving blank will use DNS Resolution instead."
msgstr "Ingiza anwani ya IP ya kuunganisha kwayo.  Kuacha wazi kutatumia Utatuzi wa DNS badala yake."

#: includes/arrays.php
msgid "Proxy Server"
msgstr "Seva ya Proksi"

#: includes/arrays.php
msgid "If this connection text requires a proxy, select it here.  Otherwise choose 'None'."
msgstr "Ikiwa maandishi haya ya muunganisho yanahitaji proksi, ichague hapa. Vinginevyo chagua 'Hakuna'."

#: includes/arrays.php webseer.php
msgid "None"
msgstr "Hakuna"

#: includes/arrays.php webseer.php
msgid "Compression"
msgstr "Mfinyazo"

#: includes/arrays.php
msgid "What compression does the server require?  Most servers should not need this, but some will not redirect properly without it."
msgstr "Je, seva inahitaji mbano gani?  Seva nyingi hazipaswi kuhitaji hili, lakini baadhi hazitaelekeza kwingine ipasavyo bila hilo."

#: includes/arrays.php
msgid "Available Checks"
msgstr "Ukaguzi Uliopo"

#: includes/arrays.php
msgid "Requires Authentication"
msgstr "Inahitaji Uthibitishaji"

#: includes/arrays.php
msgid "Check this box if the site will normally return a 401 Error as it requires a username and password."
msgstr "Tiki kisanduku hiki ikiwa eneo kwa kawaida litarudisha Hitilafu ya 401 kwani linahitaji jina la mtumiaji na nenosiri."

#: includes/arrays.php
msgid "Check Certificate"
msgstr "Kagua Cheti"

#: includes/arrays.php
msgid "If using SSL, check this box if you want to validate the certificate. Default on, turn off if you the site uses a self-signed certificate."
msgstr "Ikiwa unatumia SSL, teua kisanduku hiki ikiwa unataka kuthibitisha cheti. Chaguo-msingi imewashwa, zima ikiwa eneo linatumia cheti kilichosainiwa chenyewe."

#: includes/arrays.php
msgid "Notification Timing"
msgstr "Muda wa Arifa"

#: includes/arrays.php
msgid "Trigger"
msgstr "Kichocheo"

#: includes/arrays.php
msgid "How many minutes the URL must be down before it will send an alert.  After an alert is sent, in order for a 'Site Recovering' Email to be send, it must also be up this number of minutes."
msgstr "Dakika ngapi URL lazima iwe chini kabla haijatuma tahadhari. Baada ya tahadhari kutumwa, ili Barua Pepe ya 'Eneo Linarejea' itumwe, lazima pia iwe juu kwa idadi hii ya dakika."

#: includes/arrays.php
msgid "Time Out"
msgstr "Muda Umeisha"

#: includes/arrays.php
msgid "How many seconds to allow the page to timeout before reporting it as down."
msgstr "Sekunde ngapi za kuruhusu ukurasa upitishe muda kabla ya kuuripoti kuwa chini."

#: includes/arrays.php
msgid "Verification Strings"
msgstr "Mifuatano ya Uthibitishaji"

#: includes/arrays.php
msgid "Response Search String"
msgstr "Mfuatano wa Kutafuta Jibu"

#: includes/arrays.php
msgid "This is the string to search for in the URL response for a live and working Web Service."
msgstr "Hii ni tungo ya kutafuta katika jibu la URL kwa Huduma ya Wavuti iliyo hai na inayofanya kazi."

#: includes/arrays.php
msgid "Response Search String - Maintenance Page"
msgstr "Mfuatano wa Kutafuta Jibu - Ukurasa wa Matengenezo"

#: includes/arrays.php
msgid "This is the string to search for on the Maintenance Page.  The Service Check will check for this string if the above string is not found.  If found, it means that the Web Service is under maintenance."
msgstr "Hii ni tungo ya kutafuta kwenye Ukurasa wa Matengenezo. Ukaguzi wa Huduma utatafuta tungo hii ikiwa tungo iliyo hapo juu haitapatikana. Ikipatikana, inamaanisha kuwa Huduma ya Wavuti iko chini ya matengenezo."

#: includes/arrays.php
msgid "Response Search String - Failed"
msgstr "Mfuatano wa Kutafuta Jibu - Imeshindwa"

#: includes/arrays.php
msgid "This is the string to search for a known failure in the Web Service response.  The Service Check will only alert if this string is found, ignoring any timeout issues and the search strings above."
msgstr "Hii ni tungo ya kutafuta hitilafu inayojulikana katika jibu la Huduma ya Wavuti. Ukaguzi wa Huduma utatoa arifa tu ikiwa tungo hii itapatikana, ukipuuza matatizo yoyote ya muda kuisha na tungo za utafutaji zilizo hapo juu."

#: includes/arrays.php
msgid "Notification Settings"
msgstr "Mipangilio ya Arifa"

#: includes/arrays.php
msgid "Notify Format"
msgstr "Muundo wa Arifa"

#: includes/arrays.php
msgid "This is the format to use when sending the notification email"
msgstr "Huu ni muundo wa kutumia wakati wa kutuma barua pepe ya arifa"

#: includes/arrays.php
msgid "Notification List"
msgstr "Orodha ya Arifa"

#: includes/arrays.php
msgid "Use this Notification List for those to be notified when this website goes down."
msgstr "Tumia Orodha hii ya Arifa kwa wale watakaoarifiwa tovuti hii ikizima."

#: includes/arrays.php
msgid "Notify Accounts"
msgstr "Akaunti za Kuarifu"

#: includes/arrays.php
msgid "This is a listing of accounts that will be notified when this website goes down."
msgstr "Hii ni orodha ya akaunti zitakazoarifiwa tovuti hii inapoacha kufanya kazi."

#: includes/arrays.php
msgid "Extra Alert Emails"
msgstr "Barua Pepe za Ziada za Tahadhari"

#: includes/arrays.php
msgid "You may specify here extra Emails to receive alerts for this URL (comma separated)"
msgstr "Unaweza kubainisha hapa Barua Pepe za ziada za kupokea arifa za URL hii (zimetenganishwa kwa koma)"

