#: includes/arrays.php
msgid "Uncheck this box to disabled this server from checking urls."
msgstr "Yọ àmì kúrò nínú àpótí yìí láti dẹ́kun olùpèsè yìí láti máa ṣàyẹ̀wò àwọn URL."

#: includes/arrays.php
