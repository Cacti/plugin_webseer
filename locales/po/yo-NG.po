msgstr "Èyí ni URL láti sopọ̀ mọ́ remote.php lórí olùpèsè yìí."

#: includes/arrays.php webseer_servers.php
msgid "Location"
msgstr "Ibùdó"

#: includes/arrays.php
msgid "Location of this server"
msgstr "Ipò tí olùpèsè yìí wà"

#: includes/arrays.php
msgid "Service Check Name"
msgstr "Orúkọ Àyẹ̀wò Iṣẹ́"

#: includes/arrays.php
msgid "The name that is displayed for this Service Check, and is included in any Alert notifications."
msgstr "Orúkọ tí a fi hàn fún Àyẹ̀wò Iṣẹ́ yìí, tí a sì fi kún èyíkéyìí nínú àwọn ìfitónilétí Ìtànijì."

#: includes/arrays.php webseer.php
msgid "Enable Service Check"
msgstr "Mú Àyẹ̀wò Iṣẹ́ ṣiṣẹ́"

#: includes/arrays.php
msgid "Uncheck this box to disabled this url from being checked."
msgstr "Yọ àmì kúrò nínú àpótí yìí láti dẹ́kun ṣíṣàyẹ̀wò URL yìí."

#: includes/arrays.php
msgid "The URL to Monitor"
msgstr "URL láti Ṣàbójútó"

#: includes/arrays.php
msgid "Enter an IP address to connect to.  Leaving blank will use DNS Resolution instead."
msgstr "Tẹ àdírẹ́sì IP kan láti sopọ̀ mọ́.  Fífisílẹ̀ ní òfo yóò lo Ìyanjú DNS dípò."

#: includes/arrays.php
msgid "Proxy Server"
msgstr "Olùpèsè Aṣojú"

#: includes/arrays.php
msgid "If this connection text requires a proxy, select it here.  Otherwise choose 'None'."
msgstr "Tí ọ̀rọ̀ ìsopọ̀ yìí bá nílò aṣojú (proxy), yàn án níbí. Bíbẹ́ẹ̀kọ́ yan 'Kò sí'."

#: includes/arrays.php webseer.php
msgid "None"
msgstr "Kò Sí"

#: includes/arrays.php webseer.php
msgid "Compression"
msgstr "Ìfúnpọ̀"

#: includes/arrays.php
msgid "What compression does the server require?  Most servers should not need this, but some will not redirect properly without it."
msgstr "Ìfúnkéré wo ni olùpèsè nílò?  Ọ̀pọ̀lọpọ̀ àwọn olùpèsè kò yẹ kí wọ́n nílò èyí, ṣùgbọ́n àwọn kan kò ní darí padà dáadáa láìsí rẹ̀."

#: includes/arrays.php
msgid "Available Checks"
msgstr "Àwọn Àyẹ̀wò Tó Wà Nílẹ̀"

#: includes/arrays.php
msgid "Requires Authentication"
msgstr "Nílò Ìdánimọ̀"

#: includes/arrays.php
msgid "Check this box if the site will normally return a 401 Error as it requires a username and password."
msgstr "Fi àmì sí àpótí yìí tí Ibùdó náà bá sábà máa ń dá Àṣìṣe 401 padà nítorí pé ó nílò Orúkọ Olùlò àti Ọ̀rọ̀ Aṣínà."

#: includes/arrays.php
msgid "Check Certificate"
msgstr "Ṣàyẹ̀wò Ìwé-ẹ̀rí"

#: includes/arrays.php
msgid "If using SSL, check this box if you want to validate the certificate. Default on, turn off if you the site uses a self-signed certificate."
msgstr "Tí o bá ń lo SSL, ṣàmì sí àpótí yìí tí o bá fẹ́ fọwọ́sí ìwé-ẹ̀rí náà. Ó wà ní ṣíṣí ní ìbẹ̀rẹ̀, pa á tí Ibùdó náà bá ń lo ìwé-ẹ̀rí tí a fọwọ́sí fúnra rẹ̀."

#: includes/arrays.php
msgid "Notification Timing"
msgstr "Àkókò Ìfitọ́nilétí"

#: includes/arrays.php
msgid "Trigger"
msgstr "Okùnfà"

#: includes/arrays.php
msgid "How many minutes the URL must be down before it will send an alert.  After an alert is sent, in order for a 'Site Recovering' Email to be send, it must also be up this number of minutes."
msgstr "Ìṣẹ́jú mélòó ni URL gbọ́dọ̀ wà ní ìsàlẹ̀ kí ó tó fi ìkìlọ̀ ránṣẹ́.  Lẹ́yìn tí a bá ti fi ìkìlọ̀ ránṣẹ́, kí a tó lè fi Ímeèlì 'Ibùdó Ń Bọ̀ Sípò' ránṣẹ́, ó tún gbọ́dọ̀ wà lókè fún iye ìṣẹ́jú yìí."

#: includes/arrays.php
msgid "Time Out"
msgstr "Àkókò Ti Parí"

#: includes/arrays.php
msgid "How many seconds to allow the page to timeout before reporting it as down."
msgstr "Ìṣẹ́jú-àáyá mélòó láti gba ojú-ewé láyè kí àkókò rẹ̀ tó parí ṣáájú kí a tó ròyìn rẹ̀ pé ó wà ní ìsàlẹ̀."

#: includes/arrays.php
msgid "Verification Strings"
msgstr "Àwọn Okùn Ìjẹ́rìísí"

#: includes/arrays.php
msgid "Response Search String"
msgstr "Òkùn Ìwádìí Ìdáhùn"

#: includes/arrays.php
msgid "This is the string to search for in the URL response for a live and working Web Service."
msgstr "Èyí ni okùn-ọ̀rọ̀ láti wá nínú ìdáhùn URL fún Iṣẹ́ Wẹ́ẹ̀bù tí ó wà láàyè tí ó sì ń ṣiṣẹ́."

#: includes/arrays.php
msgid "Response Search String - Maintenance Page"
msgstr "Òkùn Ìwádìí Ìdáhùn - Ojú-ewé Àtúnṣe"

#: includes/arrays.php
msgid "This is the string to search for on the Maintenance Page.  The Service Check will check for this string if the above string is not found.  If found, it means that the Web Service is under maintenance."
msgstr "Èyí ni okùn-ọ̀rọ̀ láti wá lórí Ojú-ewé Ìtọ́jú. Àyẹ̀wò Iṣẹ́ yóò ṣàyẹ̀wò fún okùn-ọ̀rọ̀ yìí tí kò bá rí okùn-ọ̀rọ̀ lókè. Tí ó bá rí i, ó túmọ̀ sí pé Iṣẹ́ Wẹ́ẹ̀bù náà wà lábẹ́ ìtọ́jú."

#: includes/arrays.php
msgid "Response Search String - Failed"
msgstr "Òkùn Ìwádìí Ìdáhùn - Kùnà"

#: includes/arrays.php
msgid "This is the string to search for a known failure in the Web Service response.  The Service Check will only alert if this string is found, ignoring any timeout issues and the search strings above."
msgstr "Èyí ni okùn-ọ̀rọ̀ láti wá ìkùnà tí a mọ̀ nínú ìdáhùn Iṣẹ́ Wẹ́ẹ̀bù. Àyẹ̀wò Iṣẹ́ yóò kìlọ̀ nìkan tí a bá rí okùn-ọ̀rọ̀ yìí, nípa fífo àwọn ìṣòro àkókò-ìparí àti àwọn okùn-ọ̀rọ̀ ìwádìí lókè."

#: includes/arrays.php
msgid "Notification Settings"
msgstr "Àwọn Ètò Ìfitónilétí"

#: includes/arrays.php
msgid "Notify Format"
msgstr "Ìrísí Ìfitọ́nilétí"

#: includes/arrays.php
msgid "This is the format to use when sending the notification email"
msgstr "Èyí ni ìṣètò láti lò nígbà tí a bá ń fi ímeèlì ìfitónilétí ránṣẹ́"

#: includes/arrays.php
msgid "Notification List"
msgstr "Àtòjọ Ìfitónilétí"

#: includes/arrays.php
msgid "Use this Notification List for those to be notified when this website goes down."
msgstr "Lo Àtòjọ Ìfitọ́nilétí yìí fún àwọn tí a ó fi tó létí nígbà tí ojú òpó wẹ́ẹ̀bù yìí bá dáwọ́ dúró."

#: includes/arrays.php
msgid "Notify Accounts"
msgstr "Fitọ́nilétí Àwọn Àkántì"

#: includes/arrays.php
msgid "This is a listing of accounts that will be notified when this website goes down."
msgstr "Èyí jẹ́ àkójọ àwọn àkọọ́lẹ̀ tí a ó fi tó létí nígbà tí ojú-òpó wẹ́ẹ̀bù yìí bá dáwọ́ dúró."

#: includes/arrays.php
msgid "Extra Alert Emails"
msgstr "Àwọn Ímeèlì Ìtanilólobó Àfikún"

#: includes/arrays.php
msgid "You may specify here extra Emails to receive alerts for this URL (comma separated)"
msgstr "O lè tọ́ka sí àwọn Ímeèlì àfikún níbí láti gba àwọn ìtànijí fún URL yìí (tí a fi kọ́mà pín sí)"

