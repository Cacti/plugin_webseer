#: includes/arrays.php webseer_servers.php
msgid "Enable Server"
msgid_plural "Enable Servers"
msgstr[0] "Kunna Sabar"
msgstr[1] "Kunna Sabobi"

#: includes/arrays.php
msgid "Uncheck this box to disabled this server from checking urls."
msgstr "Cire alama a wannan akwatin don hana wannan uwar garken duba adiresoshin URL."

#: includes/arrays.php
msgid "Is this server the local server?"
msgstr "Shin wannan uwar garken ita ce uwar garken gida?"

#: includes/arrays.php
msgid "Check this box if the current server you are connected to is this entry."
msgstr "Yi alama a wannan akwatin idan sabar da kake haɗe da ita a yanzu ita ce wannan shigarwar."

#: includes/arrays.php
msgid "Master Server"
msgstr "Babban Sabar"

#: includes/arrays.php
msgid "Sets this server to the Master server.  The Master server handles all Email operations"
msgstr "Yana saita wannan uwar garken zuwa Babbar uwar garke.  Babbar uwar garken tana kula da duk ayyukan Imel"

#: includes/arrays.php webseer_servers.php
msgid "IP Address"
msgstr "Adireshin IP"

#: includes/arrays.php
msgid "IP Address to connect to this server"
msgstr "Adireshin IP don haɗawa da wannan sabar"

#: includes/arrays.php webseer.php webseer_servers.php
msgid "URL"
msgstr "URL"

#: includes/arrays.php
msgid "This is the URL to connect to remote.php on this server."
msgstr "Wannan shine URL don haɗawa zuwa remote.php akan wannan sabar."

#: includes/arrays.php webseer_servers.php
msgid "Location"
msgstr "Wuri"

#: includes/arrays.php
msgid "Location of this server"
msgstr "Wurin wannan uwar garken"

#: includes/arrays.php
msgid "Service Check Name"
msgstr "Sunan Binciken Sabis"

#: includes/arrays.php
msgid "The name that is displayed for this Service Check, and is included in any Alert notifications."
msgstr "Sunan da ake nunawa don wannan Duba Sabis, kuma ana haɗa shi a cikin duk sanarwar Faɗakarwa."

#: includes/arrays.php webseer.php
msgid "Enable Service Check"
msgstr "Kunna Binciken Sabis"

#: includes/arrays.php
msgid "Uncheck this box to disabled this url from being checked."
msgstr "Cire alama a wannan akwatin don hana duba wannan URL ɗin."

#: includes/arrays.php
msgid "The URL to Monitor"
msgstr "URL ɗin da za a Sa Ido a kai"

#: includes/arrays.php
msgid "Enter an IP address to connect to.  Leaving blank will use DNS Resolution instead."
msgstr "Shigar da adireshin IP don haɗawa zuwa gare shi. Barin shi fanko zai yi amfani da Warwarewar DNS a madadin haka."

#: includes/arrays.php
msgid "Proxy Server"
msgstr "Sabar Wakili"

#: includes/arrays.php
msgid "If this connection text requires a proxy, select it here.  Otherwise choose 'None'."
msgstr "Idan wannan rubutun haɗi yana buƙatar proxy, zaɓe shi a nan. In ba haka ba zaɓi 'Babu'."

#: includes/arrays.php webseer.php
msgid "None"
msgstr "Babu"

#: includes/arrays.php webseer.php
msgid "Compression"
msgstr "Matsawa"

#: includes/arrays.php
msgid "What compression does the server require?  Most servers should not need this, but some will not redirect properly without it."
msgstr "Wane irin matsi sabar ke buƙata?  Yawancin sabobi ba sa buƙatar wannan, amma wasu ba za su tura yadda ya kamata ba tare da shi ba."

#: includes/arrays.php
msgid "Available Checks"
msgstr "Binciken da Ake da Su"

#: includes/arrays.php
msgid "Requires Authentication"
msgstr "Yana Buƙatar Tantancewa"

#: includes/arrays.php
msgid "Check this box if the site will normally return a 401 Error as it requires a username and password."
msgstr "Yi alama a wannan akwatin idan wurin yakan dawo da Kuskuren 401 saboda yana buƙatar sunan mai amfani da kalmar sirri."

#: includes/arrays.php
msgid "Check Certificate"
msgstr "Duba Takardar Shaida"

#: includes/arrays.php
msgid "If using SSL, check this box if you want to validate the certificate. Default on, turn off if you the site uses a self-signed certificate."
msgstr "Idan ana amfani da SSL, zaɓi wannan akwati idan kana son tabbatar da ingancin takardar shaida. Yana kunne ta tsoho, kashe idan wurin yana amfani da takardar shaida da aka sa wa hannu da kai."

#: includes/arrays.php
msgid "Notification Timing"
msgstr "Lokacin Sanarwa"

#: includes/arrays.php
msgid "Trigger"
msgstr "Mai Tada Aiki"

#: includes/arrays.php
msgid "How many minutes the URL must be down before it will send an alert.  After an alert is sent, in order for a 'Site Recovering' Email to be send, it must also be up this number of minutes."
msgstr "Mintuna nawa ya kamata URL ya kasance a kashe kafin ya aika da faɗakarwa.  Bayan an aika da faɗakarwa, domin a aika Imel na 'Wuri Yana Farfaɗowa', dole ne kuma ya kasance a kunne na wannan adadin mintuna."

#: includes/arrays.php
msgid "Time Out"
msgstr "Ƙarewar Lokaci"

#: includes/arrays.php
msgid "How many seconds to allow the page to timeout before reporting it as down."
msgstr "Dakiku nawa za a ba shafin don ƙarewar lokaci kafin a bayar da rahoton cewa ya faɗi."

#: includes/arrays.php
msgid "Verification Strings"
msgstr "Jumlolin Tabbatarwa"

#: includes/arrays.php
msgid "Response Search String"
msgstr "Kalmomin Binciken Amsa"

#: includes/arrays.php
msgid "This is the string to search for in the URL response for a live and working Web Service."
msgstr "Wannan ita ce jimlar da za a bincika a cikin amsar URL don Sabis na Yanar Gizo da ke raye kuma yana aiki."

#: includes/arrays.php
msgid "Response Search String - Maintenance Page"
msgstr "Kalmomin Binciken Amsa - Shafin Kulawa"

#: includes/arrays.php
msgid "This is the string to search for on the Maintenance Page.  The Service Check will check for this string if the above string is not found.  If found, it means that the Web Service is under maintenance."
msgstr "Wannan ita ce jimlar da za a bincika a kan Shafin Kulawa. Binciken Sabis zai bincika wannan jimlar idan ba a sami jimlar da ke sama ba. Idan an same ta, yana nufin cewa Sabis na Yanar Gizo yana ƙarƙashin gyara."

#: includes/arrays.php
msgid "Response Search String - Failed"
msgstr "Kalmomin Binciken Amsa - Ya Gaza"

#: includes/arrays.php
msgid "This is the string to search for a known failure in the Web Service response.  The Service Check will only alert if this string is found, ignoring any timeout issues and the search strings above."
msgstr "Wannan ita ce jimlar da za a bincika don sanannen gazawa a cikin amsar Sabis na Yanar Gizo. Binciken Sabis zai yi faɗakarwa ne kawai idan an sami wannan jimlar, tare da yin watsi da duk wata matsalar ƙarewar lokaci da jimlolin bincike na sama."

#: includes/arrays.php
msgid "Notification Settings"
msgstr "Saitunan Sanarwa"

#: includes/arrays.php
msgid "Notify Format"
msgstr "Tsarin Sanarwa"

#: includes/arrays.php
msgid "This is the format to use when sending the notification email"
msgstr "Wannan shine tsarin da za a yi amfani da shi lokacin aika imel na sanarwa"

#: includes/arrays.php
msgid "Notification List"
msgstr "Jerin Sanarwa"

#: includes/arrays.php
msgid "Use this Notification List for those to be notified when this website goes down."
msgstr "Yi amfani da wannan Jerin Sanarwa don waɗanda za a sanar lokacin da wannan gidan yanar gizon ya tsaya."

#: includes/arrays.php
msgid "Notify Accounts"
msgstr "Asusun Sanarwa"

#: includes/arrays.php
msgid "This is a listing of accounts that will be notified when this website goes down."
msgstr "Wannan jerin asusun da za a sanar da su ne idan wannan shafin yanar gizon ya daina aiki."

#: includes/arrays.php
msgid "Extra Alert Emails"
msgstr "Ƙarin Imel ɗin Faɗakarwa"

#: includes/arrays.php
msgid "You may specify here extra Emails to receive alerts for this URL (comma separated)"
msgstr "Za ka iya ƙayyade ƙarin Imel a nan don karɓar faɗakarwa ga wannan URL (a raba da waƙafi)"

