#: includes/arrays.php
msgid "General Settings"
msgstr "Igenamiterere rusange"

#: includes/arrays.php
msgid "Display Name of this server"
msgstr "Izina rigaragara ry'iyi seriveri"

#: includes/arrays.php webseer_servers.php
msgid "Enable Server"
msgid_plural "Enable Servers"
msgstr[0] "Fungura Seriveri"
msgstr[1] "Fungura za Seriveri"

#: includes/arrays.php
msgid "Uncheck this box to disabled this server from checking urls."
msgstr "Kura akamenyetso muri aka gasanduku kugira ngo uhagarike iyi seriveri kugenzura ama-URL."

#: includes/arrays.php
msgid "Is this server the local server?"
msgstr "Iyi seriveri ni seriveri y'imbere?"

#: includes/arrays.php
msgid "Check this box if the current server you are connected to is this entry."
msgstr "Hitamo aka gasanduku niba seriveri uhujwe nayo ubu ari iyi nyandiko."

#: includes/arrays.php
msgid "Master Server"
msgstr "Seriveri nkuru"

#: includes/arrays.php
msgid "Sets this server to the Master server.  The Master server handles all Email operations"
msgstr "Bishyiraho iyi seriveri nka seriveri Nkuru.  Seriveri Nkuru itunganya ibikorwa byose bya Imeyili"

#: includes/arrays.php webseer_servers.php
msgid "IP Address"
msgstr "Aderesi ya IP"

#: includes/arrays.php
msgid "IP Address to connect to this server"
msgstr "Aderesi ya IP yo guhuza na iyi seriveri"

#: includes/arrays.php webseer.php webseer_servers.php
msgid "URL"
msgstr "URL"

#: includes/arrays.php
msgid "This is the URL to connect to remote.php on this server."
msgstr "Iyi ni URL yo guhuza na remote.php kuri iyi seriveri."

#: includes/arrays.php webseer_servers.php
msgid "Location"
msgstr "Ahantu"

#: includes/arrays.php
msgid "Location of this server"
msgstr "Aho iyi seriveri iherereye"

#: includes/arrays.php
msgid "Service Check Name"
msgstr "Izina ry'igenzura rya serivisi"

#: includes/arrays.php
msgid "The name that is displayed for this Service Check, and is included in any Alert notifications."
msgstr "Izina ryerekanwa kuri iri Genzura rya Serivisi, kandi rishyirwa mu mamenyesha yose y'Impuruza."

#: includes/arrays.php webseer.php
msgid "Enable Service Check"
msgstr "Fungura Igenzura rya Serivisi"

#: includes/arrays.php
msgid "Uncheck this box to disabled this url from being checked."
msgstr "Kura akamenyetso muri aka gasanduku kugira ngo uhagarike igenzurwa ry'iyi URL."

#: includes/arrays.php
msgid "The URL to Monitor"
msgstr "URL yo gukurikirana"

#: includes/arrays.php
msgid "Enter an IP address to connect to.  Leaving blank will use DNS Resolution instead."
msgstr "Andika aderesi ya IP yo kwihuza na yo. Gusiga harimo ubusa bizakoresha ishakisha rya DNS aho kubikora."

#: includes/arrays.php
msgid "Proxy Server"
msgstr "Seriveri y'umuhuza"

#: includes/arrays.php
msgid "If this connection text requires a proxy, select it here.  Otherwise choose 'None'."
msgstr "Niba iyi nyandiko yo kwihuza isaba proxy, yihitemo hano. Bitabaye ibyo hitamo 'Nta na kimwe'."

#: includes/arrays.php webseer.php
msgid "None"
msgstr "Nta na kimwe"

#: includes/arrays.php webseer.php
msgid "Compression"
msgstr "Iyegeranya"

#: includes/arrays.php
msgid "What compression does the server require?  Most servers should not need this, but some will not redirect properly without it."
msgstr "Ni ubuhe buryo bwo kwegeranya amakuru seriveri isaba?  Seriveri nyinshi ntizikenera ibi, ariko zimwe ntizizayobora neza zitabifite."

#: includes/arrays.php
msgid "Available Checks"
msgstr "Amagenzura ahari"

#: includes/arrays.php
msgid "Requires Authentication"
msgstr "Bisaba kwemeza umwirondoro"

#: includes/arrays.php
msgid "Check this box if the site will normally return a 401 Error as it requires a username and password."
msgstr "Hitamo aka gasanduku niba Ahantu ubusanzwe hazana ikosa rya 401 kuko hasaba izina ry'ukoresha n'ijambobanga."

#: includes/arrays.php
msgid "Check Certificate"
msgstr "Genzura icyemezo cy'umutekano"

#: includes/arrays.php
msgid "If using SSL, check this box if you want to validate the certificate. Default on, turn off if you the site uses a self-signed certificate."
msgstr "Niba ukoresha SSL, shyira akamenyetso muri aka gasanduku niba ushaka kwemeza icyemezo. Mu buryo busanzwe birafunguye, bihagarike niba urubuga rukoresha icyemezo cyishyiriweho umukono."

#: includes/arrays.php
msgid "Notification Timing"
msgstr "Igenagihe ry'imenyesha"

#: includes/arrays.php
msgid "Trigger"
msgstr "Imbarutso"

#: includes/arrays.php
msgid "How many minutes the URL must be down before it will send an alert.  After an alert is sent, in order for a 'Site Recovering' Email to be send, it must also be up this number of minutes."
msgstr "Ni iminota ingahe URL igomba kumara itakora mbere yo kohereza impuruza.  Nyuma y'uko impuruza yoherejwe, kugira ngo Imeyili ya 'Ahantu hari gukira' yoherezwe, igomba kandi kumara uwo mubare w'iminota ikora."

#: includes/arrays.php
msgid "Time Out"
msgstr "Igihe Cyarenze"

#: includes/arrays.php
msgid "How many seconds to allow the page to timeout before reporting it as down."
msgstr "Umubare w'amasegonda yo gutegereza ipaji mbere yo gutangaza ko itari gukora."

#: includes/arrays.php
msgid "Verification Strings"
msgstr "Imirongo y'inyuguti yo kugenzura"

#: includes/arrays.php
msgid "Response Search String"
msgstr "Ijambo rishakishwa mu gisubizo"

#: includes/arrays.php
msgid "This is the string to search for in the URL response for a live and working Web Service."
msgstr "Iyi ni inyandiko yo gushakisha mu gisubizo cya URL kuri Serivisi ya Web iriho kandi ikora."

#: includes/arrays.php
msgid "Response Search String - Maintenance Page"
msgstr "Ijambo rishakishwa mu gisubizo - Urupapuro rw'imirimo y'isana"

#: includes/arrays.php
msgid "This is the string to search for on the Maintenance Page.  The Service Check will check for this string if the above string is not found.  If found, it means that the Web Service is under maintenance."
msgstr "Iyi ni inyandiko yo gushakisha ku Rupapuro rw'Isana.  Igenzura rya Serivisi rizashakisha iyi nyandiko niba inyandiko iri hejuru itabonetse.  Niba ibonetse, bisobanura ko Serivisi ya Web iri mu isana."

#: includes/arrays.php
msgid "Response Search String - Failed"
msgstr "Ijambo rishakishwa mu gisubizo - Byanze"

#: includes/arrays.php
msgid "This is the string to search for a known failure in the Web Service response.  The Service Check will only alert if this string is found, ignoring any timeout issues and the search strings above."
msgstr "Iyi ni inyandiko yo gushakisha ikibazo kizwi mu gisubizo cya Serivisi ya Web.  Igenzura rya Serivisi rizamenyesha gusa niba iyi nyandiko ibonetse, ryirengagiza ibibazo byo kurenza igihe n'inyandiko zo gushakisha ziri hejuru."

#: includes/arrays.php
msgid "Notification Settings"
msgstr "Igenamiterere ry'imenyesha"

#: includes/arrays.php
msgid "Notify Format"
msgstr "Imiterere y'imenyesha"

#: includes/arrays.php
msgid "This is the format to use when sending the notification email"
msgstr "Iyi ni imiterere yo gukoresha igihe wohereza imeyili y'imenyekanisha"

#: includes/arrays.php
msgid "Notification List"
msgstr "Urutonde rw'abamenyeshwa"

#: includes/arrays.php
msgid "Use this Notification List for those to be notified when this website goes down."
msgstr "Koresha uru rutonde rw'imenyesha ku bagomba kumenyeshwa igihe uru rubuga ruhagaze."

#: includes/arrays.php
msgid "Notify Accounts"
msgstr "Konti zo kumenyesha"

#: includes/arrays.php
msgid "This is a listing of accounts that will be notified when this website goes down."
msgstr "Uru ni urutonde rwa konti zizamenyeshwa igihe uru rubuga ruhagaze."

#: includes/arrays.php
msgid "Extra Alert Emails"
msgstr "Imeyili z'inyongera z'intabaza"

#: includes/arrays.php
msgid "You may specify here extra Emails to receive alerts for this URL (comma separated)"
msgstr "Ushobora kugaragaza hano izindi Imeyili zakira impuruza z'iyi URL (zitandukanyijwe n'akitso)"

