#: includes/arrays.php webseer_servers.php
msgid "Enable Server"
msgid_plural "Enable Servers"
msgstr[0] "Vula Iseva"
msgstr[1] "Vula Iiseva"

#: includes/arrays.php
msgid "Uncheck this box to disabled this server from checking urls."
msgstr "Susa uphawu kule bhokisi ukucima le seva ekujongeni ii-URL."

#: includes/arrays.php
msgid "Is this server the local server?"
msgstr "Ngaba le seva yiseva yasekhaya?"

#: includes/arrays.php
msgid "Check this box if the current server you are connected to is this entry."
msgstr "Phawula le bhokisi ukuba iseva yangoku oqhagamshelwe kuyo leli ngeno."

#: includes/arrays.php
msgid "Master Server"
msgstr "Iseva eyiNtloko"

#: includes/arrays.php
msgid "Sets this server to the Master server.  The Master server handles all Email operations"
msgstr "Iseta le seva njengeseva ye-Master.  Iseva ye-Master ilawula yonke imisebenzi ye-imeyile"

#: includes/arrays.php webseer_servers.php
msgid "IP Address"
msgstr "Idilesi ye-IP"

#: includes/arrays.php
msgid "IP Address to connect to this server"
msgstr "IDilesi ye-IP yokudibanisa kule seva"

#: includes/arrays.php webseer.php webseer_servers.php
msgid "URL"
msgstr "URL"

#: includes/arrays.php
msgid "This is the URL to connect to remote.php on this server."
msgstr "Le yi-URL yokuqhagamshela kwi-remote.php kule seva."

#: includes/arrays.php webseer_servers.php
msgid "Location"
msgstr "Indawo"

#: includes/arrays.php
msgid "Location of this server"
msgstr "Indawo yale seva"

#: includes/arrays.php
msgid "Service Check Name"
msgstr "Igama loHlolo lweNkonzo"

#: includes/arrays.php
msgid "The name that is displayed for this Service Check, and is included in any Alert notifications."
msgstr "Igama eliboniswayo kolu Vavanyo lweNkonzo, kwaye eliqukiweyo kuzo naziphi na izaziso zeZilumkiso."

#: includes/arrays.php webseer.php
msgid "Enable Service Check"
msgstr "Vula uHlolo lweNkonzo"

#: includes/arrays.php
msgid "Uncheck this box to disabled this url from being checked."
msgstr "Susa uphawu kule bhokisi ukucima le URL ekujongweni."

#: includes/arrays.php
msgid "The URL to Monitor"
msgstr "I-URL eza kubekwa esweni"

#: includes/arrays.php
msgid "Enter an IP address to connect to.  Leaving blank will use DNS Resolution instead."
msgstr "Faka idilesi ye-IP oza kuqhagamshela kuyo.  Ukushiya kungenanto kuya kusebenzisa uSombululo lwe-DNS endaweni yoko."

#: includes/arrays.php
msgid "Proxy Server"
msgstr "Iseva ye-Proxy"

#: includes/arrays.php
msgid "If this connection text requires a proxy, select it here.  Otherwise choose 'None'."
msgstr "Ukuba lo mbhalo woqhagamshelwano ufuna i-proxy, yikhethe apha. Kungenjalo khetha 'Akukho'."

#: includes/arrays.php webseer.php
msgid "None"
msgstr "Akukho"

#: includes/arrays.php webseer.php
msgid "Compression"
msgstr "Uxinzelelo"

#: includes/arrays.php
msgid "What compression does the server require?  Most servers should not need this, but some will not redirect properly without it."
msgstr "Loluphi ucinezelelo olufunwa yiseva?  Iiseva ezininzi azifanele zikudinge oku, kodwa ezinye azizukuthumela kwelinye ikhasi ngokuchanekileyo ngaphandle kwalo."

#: includes/arrays.php
msgid "Available Checks"
msgstr "Iitshekhi eziFumanekayo"

#: includes/arrays.php
msgid "Requires Authentication"
msgstr "Ifuna Uqinisekiso"

#: includes/arrays.php
msgid "Check this box if the site will normally return a 401 Error as it requires a username and password."
msgstr "Phawula le bhokisi ukuba isiza sihlala sibuyisa iPhutha le-401 njengoko sifuna igama lomsebenzisi nephasiwedi."

#: includes/arrays.php
msgid "Check Certificate"
msgstr "Jonga iSiqinisekiso"

#: includes/arrays.php
msgid "If using SSL, check this box if you want to validate the certificate. Default on, turn off if you the site uses a self-signed certificate."
msgstr "Ukuba usebenzisa i-SSL, khetha le bhokisi ukuba ufuna ukuqinisekisa isatifikethi. Ngokungagqibekanga ivuliwe, cima ukuba isiza sisebenzisa isatifikethi esizisayinelweyo."

#: includes/arrays.php
msgid "Notification Timing"
msgstr "Ixesha Lezaziso"

#: includes/arrays.php
msgid "Trigger"
msgstr "Isivuseleli"

#: includes/arrays.php
msgid "How many minutes the URL must be down before it will send an alert.  After an alert is sent, in order for a 'Site Recovering' Email to be send, it must also be up this number of minutes."
msgstr "Mingaphi imizuzu i-URL ekufuneka ibe phantsi ngayo phambi kokuba ithumele isilumkiso.  Emva kokuba isilumkiso sithunyelwe, ukuze kuthunyelwe I-imeyile ye-'Isiza Siyachacha', kufuneka kwakhona ibe phezulu eli nani lemizuzu."

#: includes/arrays.php
msgid "Time Out"
msgstr "Ixesha liphelile"

#: includes/arrays.php
msgid "How many seconds to allow the page to timeout before reporting it as down."
msgstr "Mingaphi imizuzwana yokuvumela iphepha liphelelwe lixesha phambi kokulixela njengeliphantsi."

#: includes/arrays.php
msgid "Verification Strings"
msgstr "Imitya yoQinisekiso"

#: includes/arrays.php
msgid "Response Search String"
msgstr "Umtya wokuKhangela iMpendulo"

#: includes/arrays.php
msgid "This is the string to search for in the URL response for a live and working Web Service."
msgstr "Lo ngumtya wokukhangela kwimpendulo ye-URL kwiNkonzo yeWebhu ephilayo nesebenzayo."

#: includes/arrays.php
msgid "Response Search String - Maintenance Page"
msgstr "Umtya wokuKhangela iMpendulo - Iphepha loLondolozo"

#: includes/arrays.php
msgid "This is the string to search for on the Maintenance Page.  The Service Check will check for this string if the above string is not found.  If found, it means that the Web Service is under maintenance."
msgstr "Lo ngumtya wokukhangela kwiPhepha loLondolozo. Ukujongwa kweNkonzo kuya kukhangela lo mtya ukuba umtya ongentla awufunyenwanga. Ukuba ufunyenwe, kuthetha ukuba iNkonzo yeWebhu ikulondolozo."

#: includes/arrays.php
msgid "Response Search String - Failed"
msgstr "Umtya wokuKhangela iMpendulo - Ayiphumelelanga"

#: includes/arrays.php
msgid "This is the string to search for a known failure in the Web Service response.  The Service Check will only alert if this string is found, ignoring any timeout issues and the search strings above."
msgstr "Lo ngumtya wokukhangela ukusilela okwaziwayo kwimpendulo yeNkonzo yeWebhu. Ukujongwa kweNkonzo kuya kwazisa kuphela ukuba lo mtya ufunyenwe, kungahoywa nayiphi na imiba yokuphelelwa lixesha kunye nemitya yokukhangela engentla."

#: includes/arrays.php
msgid "Notification Settings"
msgstr "Useto Lwesaziso"

#: includes/arrays.php
msgid "Notify Format"
msgstr "Ifomathi Yokwazisa"

#: includes/arrays.php
msgid "This is the format to use when sending the notification email"
msgstr "Le yifomathi emayisetyenziswe xa kuthunyelwa i-imeyile yesaziso"

#: includes/arrays.php
msgid "Notification List"
msgstr "Uluhlu lweZaziso"

#: includes/arrays.php
msgid "Use this Notification List for those to be notified when this website goes down."
msgstr "Sebenzisa olu Luhlu lweZaziso kwabo baza kwaziswa xa le webhusayithi iyeka ukusebenza."

#: includes/arrays.php
msgid "Notify Accounts"
msgstr "Yazisa Ii-akhawunti"

#: includes/arrays.php
msgid "This is a listing of accounts that will be notified when this website goes down."
msgstr "Olu luluhlu lwee-akhawunti eziya kwaziswa xa le webhusayithi iyeka ukusebenza."

#: includes/arrays.php
msgid "Extra Alert Emails"
msgstr "Ii-imeyile zeZilumkiso ezongezelelweyo"

#: includes/arrays.php
msgid "You may specify here extra Emails to receive alerts for this URL (comma separated)"
msgstr "Ungachaza apha ii-imeyile ezongezelelweyo zokufumana izixwayiso zale URL (zahlulwe ngekoma)"

