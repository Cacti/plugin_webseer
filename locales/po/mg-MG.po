#: includes/arrays.php webseer_servers.php
msgid "Enable Server"
msgid_plural "Enable Servers"
msgstr[0] "Ataovy mavitrika ny lohamilina"
msgstr[1] "Ataovy mavitrika ireo lohamilina"

#: includes/arrays.php
msgid "Uncheck this box to disabled this server from checking urls."
msgstr "Esory ny marika amin'ity boaty ity mba tsy hanamarina URL intsony ity mpizara ity."

#: includes/arrays.php
msgid "Is this server the local server?"
msgstr "Ity mpizara ity ve no mpizara eo an-toerana?"

#: includes/arrays.php
msgid "Check this box if the current server you are connected to is this entry."
msgstr "Mariho ity boaty ity raha ity fidirana ity ny lohamilina ifandraisanao amin'izao fotoana izao."

#: includes/arrays.php
msgid "Master Server"
msgstr "Mpizara lohany"

#: includes/arrays.php
msgid "Sets this server to the Master server.  The Master server handles all Email operations"
msgstr "Mametraka ity lohamilina ity ho lohamilina Master.  Ny lohamilina Master no mitantana ny asa Mailaka rehetra"

#: includes/arrays.php webseer_servers.php
msgid "IP Address"
msgstr "Adiresy IP"

#: includes/arrays.php
msgid "IP Address to connect to this server"
msgstr "Adiresy IP hifandraisana amin'ity lohamilina ity"

#: includes/arrays.php webseer.php webseer_servers.php
msgid "URL"
msgstr "URL"

#: includes/arrays.php
msgid "This is the URL to connect to remote.php on this server."
msgstr "Ity ny URL hifandraisana amin'ny remote.php ao amin'ity mpizara ity."

#: includes/arrays.php webseer_servers.php
msgid "Location"
msgstr "Toerana"

#: includes/arrays.php
msgid "Location of this server"
msgstr "Toerana misy ity lohamilina ity"

#: includes/arrays.php
msgid "Service Check Name"
msgstr "Anaran'ny fanamarinana tolotra"

#: includes/arrays.php
msgid "The name that is displayed for this Service Check, and is included in any Alert notifications."
msgstr "Ny anarana aseho ho an'ity Fanamarinana Serivisy ity, ary ampidirina ao amin'ny fampandrenesana Fanairana rehetra."

#: includes/arrays.php webseer.php
msgid "Enable Service Check"
msgstr "Alefaso ny fanamarinana tolotra"

#: includes/arrays.php
msgid "Uncheck this box to disabled this url from being checked."
msgstr "Esory ny marika amin'ity boaty ity mba tsy ho voamarina intsony ity URL ity."

#: includes/arrays.php
msgid "The URL to Monitor"
msgstr "Ny URL arahi-maso"

#: includes/arrays.php
msgid "Enter an IP address to connect to.  Leaving blank will use DNS Resolution instead."
msgstr "Ampidiro adiresy IP hifandraisana.  Raha avela ho banga dia ny Famahana DNS no hampiasaina."

#: includes/arrays.php
msgid "Proxy Server"
msgstr "Mpizara mpanelanelana"

#: includes/arrays.php
msgid "If this connection text requires a proxy, select it here.  Otherwise choose 'None'."
msgstr "Raha mitaky proxy ity lahatsoratra fifandraisana ity, dia fidio eto izany. Raha tsy izany, fidio ny 'Tsy misy'."

#: includes/arrays.php webseer.php
msgid "None"
msgstr "Tsy misy"

#: includes/arrays.php webseer.php
msgid "Compression"
msgstr "Fangejana"

#: includes/arrays.php
msgid "What compression does the server require?  Most servers should not need this, but some will not redirect properly without it."
msgstr "Inona ny fanerena takian'ny mpizara?  Ny ankamaroan'ny mpizara dia tsy tokony hila izany, saingy ny sasany dia tsy hampitodika araka ny tokony ho izy raha tsy misy izany."

#: includes/arrays.php
msgid "Available Checks"
msgstr "Fanamarinana misy"

#: includes/arrays.php
msgid "Requires Authentication"
msgstr "Mitaky fanamarinana"

#: includes/arrays.php
msgid "Check this box if the site will normally return a 401 Error as it requires a username and password."
msgstr "Mariho ity boaty ity raha mamerina hadisoana 401 matetika ny toerana satria mitaky anaran'ny mpampiasa sy tenimiafina."

#: includes/arrays.php
msgid "Check Certificate"
msgstr "Hamarino ny taratasy fanamarinana"

#: includes/arrays.php
msgid "If using SSL, check this box if you want to validate the certificate. Default on, turn off if you the site uses a self-signed certificate."
msgstr "Raha mampiasa SSL, mariho ity boaty ity raha te hanamarina ny mari-pankatoavana ianao. Mandeha amin'ny fomba mahazatra, vonoy raha mampiasa mari-pankatoavana nosoniaviny manokana ny toerana."

#: includes/arrays.php
msgid "Notification Timing"
msgstr "Fotoana fandefasana fampandrenesana"

#: includes/arrays.php
msgid "Trigger"
msgstr "Mpandrisika"

#: includes/arrays.php
msgid "How many minutes the URL must be down before it will send an alert.  After an alert is sent, in order for a 'Site Recovering' Email to be send, it must also be up this number of minutes."
msgstr "Firy minitra no tsy maintsy ho maty ny URL alohan'ny handefasana fanairana.  Rehefa lasa ny fanairana, mba handefasana Mailaka 'Toerana miverina mandeha', dia tsy maintsy mandeha mandritra io isan'ny minitra io koa izy."

#: includes/arrays.php
msgid "Time Out"
msgstr "Lany ny fe-potoana"

#: includes/arrays.php
msgid "How many seconds to allow the page to timeout before reporting it as down."
msgstr "Firy segondra no omena alohan'ny hiheverana fa tapaka ny fe-potoana (timeout) amin'ny pejy ary hitaterana azy ho maty."

#: includes/arrays.php
msgid "Verification Strings"
msgstr "Teny fanamarinana"

#: includes/arrays.php
msgid "Response Search String"
msgstr "Teny fikarohana amin'ny valiny"

#: includes/arrays.php
msgid "This is the string to search for in the URL response for a live and working Web Service."
msgstr "Ity no laha-tsoratra karohina ao amin'ny valin'ny URL ho an'ny Sampan-draharaha Web velona sy miasa."

#: includes/arrays.php
msgid "Response Search String - Maintenance Page"
msgstr "Teny fikarohana amin'ny valiny - Pejy fikojakojana"

#: includes/arrays.php
msgid "This is the string to search for on the Maintenance Page.  The Service Check will check for this string if the above string is not found.  If found, it means that the Web Service is under maintenance."
msgstr "Ity no laha-tsoratra karohina ao amin'ny Pejy Fikojakojana. Hanamarina ity laha-tsoratra ity ny Fanamarinana Sampan-draharaha raha tsy hita ilay laha-tsoratra etsy ambony. Raha hita izany dia midika fa eo am-pikojakojana ilay Sampan-draharaha Web."

#: includes/arrays.php
msgid "Response Search String - Failed"
msgstr "Teny fikarohana amin'ny valiny - Tsy nahomby"

#: includes/arrays.php
msgid "This is the string to search for a known failure in the Web Service response.  The Service Check will only alert if this string is found, ignoring any timeout issues and the search strings above."
msgstr "Ity no laha-tsoratra karohina mba hahitana tsy fahombiazana fantatra ao amin'ny valin'ny Sampan-draharaha Web. Hanao fampandrenesana ihany ny Fanamarinana Sampan-draharaha raha hita ity laha-tsoratra ity, ary tsy hiraharaha ny olan'ny fahataperan'ny fotoana sy ireo laha-tsoratra fikarohana etsy ambony."

#: includes/arrays.php
msgid "Notification Settings"
msgstr "Fikirana fampandrenesana"

#: includes/arrays.php
msgid "Notify Format"
msgstr "Endriky ny fampandrenesana"

#: includes/arrays.php
msgid "This is the format to use when sending the notification email"
msgstr "Ity ny endrika hampiasaina rehefa mandefa ny mailaka fampahafantarana"

#: includes/arrays.php
msgid "Notification List"
msgstr "Lisitry ny Fampandrenesana"

#: includes/arrays.php
msgid "Use this Notification List for those to be notified when this website goes down."
msgstr "Ampiasao ity Lisitry ny fampandrenesana ity ho an'ireo hampandrenesina rehefa maty ity tranonkala ity."

#: includes/arrays.php
msgid "Notify Accounts"
msgstr "Kaonty ampandrenesina"

#: includes/arrays.php
msgid "This is a listing of accounts that will be notified when this website goes down."
msgstr "Ity ny lisitry ny kaonty izay hampahafantarina rehefa maty ity tranonkala ity."

#: includes/arrays.php
msgid "Extra Alert Emails"
msgstr "Mailaka fampandrenesana fanampiny"

#: includes/arrays.php
msgid "You may specify here extra Emails to receive alerts for this URL (comma separated)"
msgstr "Azonao faritana eto ireo Mailaka fanampiny handraisana fanairana ho an'ity URL ity (sarahina faingo)"

